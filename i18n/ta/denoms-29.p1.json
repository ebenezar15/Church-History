 "denomProfiles/new-life-fellowship-india/inIndia": "மும்பையையும் மகாராஷ்டிராவையும் மையமாகக் கொண்டது.",
 "denomProfiles/myanmar-baptist-convention/tagline": "ஜட்சன் தம்பதியின் 1813 மிஷனில் வேரூன்றிய மியான்மரின் பாப்டிஸ்ட் ஒன்றியம்.",
 "denomProfiles/myanmar-baptist-convention/coreDoctrines/0": "விசுவாசியின் ஞானஸ்நானம்",
 "denomProfiles/myanmar-baptist-convention/coreDoctrines/1": "வேதாகமத்தின் அதிகாரம்",
 "denomProfiles/myanmar-baptist-convention/focuses/0": "கல்வி",
 "denomProfiles/myanmar-baptist-convention/focuses/1": "நற்செய்திப் பணி",
 "denomProfiles/myanmar-baptist-convention/practices/0": "முழுக்கு ஞானஸ்நானம்",
 "denomProfiles/myanmar-baptist-convention/keyFigures/0/name": "அடோனிராம் ஜட்சன்",
 "denomProfiles/myanmar-baptist-convention/keyFigures/0/role": "முன்னோடி மிஷனரி",
 "denomProfiles/church-of-christ-in-thailand/tagline": "பெரும்பாலும் பிரஸ்பிடேரியன் தோற்றமுடைய, தாய்லாந்தின் முதன்மையான புராட்டஸ்டன்ட் திருச்சபை.",
 "denomProfiles/church-of-christ-in-thailand/coreDoctrines/0": "சீர்திருத்த இறையியல்",
 "denomProfiles/church-of-christ-in-thailand/focuses/0": "கல்வி",
 "denomProfiles/church-of-christ-in-thailand/focuses/1": "சுகாதாரப் பணி",
 "denomProfiles/church-of-christ-in-thailand/practices/0": "குழந்தை ஞானஸ்நானம்",
 "denomProfiles/church-of-christ-in-thailand/keyFigures/0/name": "டேனியல் மெக்கில்வரி",
 "denomProfiles/church-of-christ-in-thailand/keyFigures/0/role": "சியாங் மாயில் மிஷனரி",
 "denomProfiles/gereja-protestan-indonesia/tagline": "டச்சுக் காலனித்துவத் திருச்சபையின் வாரிசான இந்தோனேசிய சீர்திருத்தச் சபைகளின் கூட்டமைப்பு.",
 "denomProfiles/gereja-protestan-indonesia/coreDoctrines/0": "சீர்திருத்த இறையியல்",
 "denomProfiles/gereja-protestan-indonesia/focuses/0": "பிராந்தியத் திருச்சபைகளின் ஒற்றுமை",
 "denomProfiles/gereja-protestan-indonesia/practices/0": "குழந்தை ஞானஸ்நானம்",
 "denomProfiles/sri-lanka-methodist-church/tagline": "1814-இல் வெஸ்லியன் மிஷனரிகளால் தொடங்கப்பட்ட இலங்கையின் மெதடிஸ்ட் திருச்சபை.",
 "denomProfiles/sri-lanka-methodist-church/coreDoctrines/0": "வெஸ்லியன் இறையியல்",
 "denomProfiles/sri-lanka-methodist-church/focuses/0": "கல்வி",
 "denomProfiles/sri-lanka-methodist-church/practices/0": "குழந்தை ஞானஸ்நானம்",
 "denomProfiles/sri-lanka-methodist-church/keyFigures/0/name": "தாமஸ் கோக்",
 "denomProfiles/sri-lanka-methodist-church/keyFigures/0/role": "மிஷனை ஒழுங்கமைத்தவர்",
 "denomProfiles/nondenominational-evangelical/tagline": "சபைப் பிரிவுப் பெயர் இல்லாத சுயாதீன சுவிசேஷ சபைகள்; பெரும்பாலும் பெரியவை, சமகாலப் பாணியுடையவை.",
 "denomProfiles/nondenominational-evangelical/coreDoctrines/0": "வேதாகமத்தின் அதிகாரமும் தேவ ஆவியால் அருளப்பட்ட தன்மையும்",
 "denomProfiles/nondenominational-evangelical/coreDoctrines/1": "கிறிஸ்துவில் தனிப்பட்ட விசுவாசத்தின் மூலம் கிருபையினால் இரட்சிப்பு",
 "denomProfiles/nondenominational-evangelical/coreDoctrines/2": "தனிப்பட்ட மனமாற்றத்தின் அவசியம்",
 "denomProfiles/nondenominational-evangelical/coreDoctrines/3": "விசுவாசியின் ஞானஸ்நானம்",
 "denomProfiles/nondenominational-evangelical/coreDoctrines/4": "கிறிஸ்துவின் தனிப்பட்ட வருகை",
 "denomProfiles/nondenominational-evangelical/focuses/0": "நற்செய்திப் பணியும், திருச்சபைக்குப் பழக்கமில்லாத மக்களைச் சென்றடைதலும்",
 "denomProfiles/nondenominational-evangelical/focuses/1": "நடைமுறை சார்ந்த, வாழ்வோடு தொடர்புடைய பிரசங்கம்",
 "denomProfiles/nondenominational-evangelical/focuses/2": "சீஷத்துவத்திற்கான சிறு குழுக்கள்",
 "denomProfiles/nondenominational-evangelical/focuses/3": "சமூக சேவையும் வெளிப்பணியும்",
 "denomProfiles/nondenominational-evangelical/practices/0": "சமகால ஆராதனை இசைக்குழுக்கள்",
 "denomProfiles/nondenominational-evangelical/practices/1": "முழுக்கு ஞானஸ்நானம், சில சமயம் பெரிய பொது ஆராதனைகளில்",
 "denomProfiles/nondenominational-evangelical/practices/2": "பல-வளாக மற்றும் இணைய வழி ஆராதனைகள்",
 "denomProfiles/nondenominational-evangelical/practices/3": "வாரநடுவில் வீட்டுக் குழுக்கள்",
 "denomProfiles/nondenominational-evangelical/influenced/0/name": "உலகளாவிய சுயாதீன சபைகள்",
 "denomProfiles/nondenominational-evangelical/influenced/0/text": "மாபெரும் சபை (மெகாசர்ச்) மாதிரிகளும் வளங்களும் ஆப்பிரிக்கா, ஆசியா, லத்தீன் அமெரிக்காவில் பரவலாகப் பின்பற்றப்பட்டுள்ளன.",
 "denomProfiles/nondenominational-evangelical/influenced/1/name": "சமகால ஆராதனை இசை",
 "denomProfiles/nondenominational-evangelical/influenced/1/text": "பெரிய சுயாதீன சபைகள் ஆராதனைப் பாடல்களின் முக்கிய தயாரிப்பாளர்களாக மாறியுள்ளன.",
 "denomProfiles/nondenominational-evangelical/keyFigures/0/name": "பில் ஹைபல்ஸ்",
 "denomProfiles/nondenominational-evangelical/keyFigures/0/role": "தேடுவோருக்கான ('seeker') சபையின் முன்மாதிரியான வில்லோ கிரீக் சமூகச் சபையை (1975) நிறுவினார்; தவறான நடத்தை குற்றச்சாட்டுகளுக்கு இடையே 2018-இல் பதவி விலகினார்.",
 "denomProfiles/nondenominational-evangelical/keyFigures/1/name": "ஜோயல் ஓஸ்டீன்",
 "denomProfiles/nondenominational-evangelical/keyFigures/1/role": "அமெரிக்காவின் மிகப்பெரிய சபைகளில் ஒன்றான ஹூஸ்டனின் லேக்வுட் சபையின் போதகர்.",
 "denomProfiles/nondenominational-evangelical/keyFigures/2/name": "ஆண்டி ஸ்டான்லி",
 "denomProfiles/nondenominational-evangelical/keyFigures/2/role": "அட்லாண்டாவில் நார்த் பாயிண்ட் சமூகச் சபையை (1995) நிறுவினார்.",
 "denomProfiles/nondenominational-evangelical/inIndia": "சுயாதீன மற்றும் சபைப் பிரிவு சாரா சபைகள் இந்திய நகரங்களில் — சென்னை உட்படத் தமிழ்நாடு மற்றும் கேரளத்தின் பிற நகரங்களிலும் — மிகவும் பொதுவானவை; அவற்றில் பல பெந்தெகொஸ்தே-கரிஸ்மாட்டிக் பாணியுடையவை; நம்பகமான தேசியக் கணக்கெடுப்பு எதுவும் இல்லை."
}
