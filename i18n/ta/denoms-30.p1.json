{
 "denomProfiles/reformed-presbyterian-covenanters/tagline": "சங்கீதங்களை மட்டுமே பாடி, தேசங்களின் மீது கிறிஸ்துவின் அரசாட்சியை அறிவிக்கும் உடன்படிக்கையாளர் பிரஸ்பிடேரியன்கள்.",
 "denomProfiles/reformed-presbyterian-covenanters/coreDoctrines/0": "திருச்சபையின் மீதும் அரசின் மீதும் கிறிஸ்துவின் அரசாட்சி",
 "denomProfiles/reformed-presbyterian-covenanters/coreDoctrines/1": "திருச்சபைகளுக்கும் தேசங்களுக்கும் உரிய கடமையாக உடன்படிக்கை செய்தல்",
 "denomProfiles/reformed-presbyterian-covenanters/coreDoctrines/2": "வெஸ்ட்மின்ஸ்டர் கால்வினிசம்",
 "denomProfiles/reformed-presbyterian-covenanters/coreDoctrines/3": "ஆராதனையின் ஒழுங்குமுறைக் கோட்பாடு",
 "denomProfiles/reformed-presbyterian-covenanters/coreDoctrines/4": "கர்த்தருடைய நாளின் பரிசுத்தம்",
 "denomProfiles/reformed-presbyterian-covenanters/focuses/0": "பொது வாழ்வில் கிறிஸ்துவின் ஆட்சிக்குச் சாட்சி பகர்தல்",
 "denomProfiles/reformed-presbyterian-covenanters/focuses/1": "சங்கீதம் பாடுதல்",
 "denomProfiles/reformed-presbyterian-covenanters/focuses/2": "உடன்படிக்கையாளர் பாரம்பரியத்திற்கு உண்மையாயிருத்தல்",
 "denomProfiles/reformed-presbyterian-covenanters/focuses/3": "மிஷன்கள்",
 "denomProfiles/reformed-presbyterian-covenanters/practices/0": "இசைக்கருவியின்றிச் சங்கீதங்களை மட்டுமே பாடுதல்",
 "denomProfiles/reformed-presbyterian-covenanters/practices/1": "உடன்படிக்கைப் புதுப்பித்தல் ஆராதனைகள்",
 "denomProfiles/reformed-presbyterian-covenanters/practices/2": "அடையாளச் சீட்டுகள் அல்லது நேர்காணல்களுடன் கூடிய மூடிய திருவிருந்து",
 "denomProfiles/reformed-presbyterian-covenanters/practices/3": "பெண் உதவிக்காரர்கள் (RPCNA, 1888 முதல்)",
 "denomProfiles/reformed-presbyterian-covenanters/influenced/0/name": "ஸ்காட்லாந்து சுதந்திரத் திருச்சபை",
 "denomProfiles/reformed-presbyterian-covenanters/influenced/0/text": "ஆவிக்குரிய சுதந்திரம் பற்றிய உடன்படிக்கையாளர் இலட்சியங்கள் 1843 பிளவுக்கு வழிவகுத்தன.",
 "denomProfiles/reformed-presbyterian-covenanters/influenced/1/name": "அமெரிக்க அடிமை ஒழிப்பு இயக்கம்",
 "denomProfiles/reformed-presbyterian-covenanters/influenced/1/text": "RPCNA உறுப்பினர்கள் அமெரிக்காவில் அடிமைத்தனத்தை ஆரம்பத்திலேயே எதிர்த்தவர்கள்.",
 "denomProfiles/reformed-presbyterian-covenanters/keyFigures/0/name": "ரிச்சர்ட் கேமரன்",
 "denomProfiles/reformed-presbyterian-covenanters/keyFigures/0/role": "1680-இல் ஏர்ட்ஸ் மாஸில் கொல்லப்பட்ட வெளியிடப் பிரசங்கியார்.",
 "denomProfiles/reformed-presbyterian-covenanters/keyFigures/1/name": "ஜேம்ஸ் ரென்விக்",
 "denomProfiles/reformed-presbyterian-covenanters/keyFigures/1/role": "மரணதண்டனை நிறைவேற்றப்பட்ட கடைசி உடன்படிக்கையாளர் (1688).",
 "denomProfiles/reformed-presbyterian-covenanters/keyFigures/2/name": "ஜான் மெக்மில்லன்",
 "denomProfiles/reformed-presbyterian-covenanters/keyFigures/2/role": "சீர்திருத்த பிரஸ்பிட்டரியின் (1743) நிறுவன ஊழியர்.",
 "denomProfiles/international-churches-of-christ/tagline": "உலக நகரங்களில் சீஷத்துவம், முழுக்கு ஞானஸ்நானம், சபை நாட்டுதல் ஆகியவற்றை வலியுறுத்தும் மீட்டெடுப்புவாதச் சபைகள்.",
 "denomProfiles/international-churches-of-christ/coreDoctrines/0": "புதிய ஏற்பாட்டுக் கிறிஸ்தவத்தை மீட்டெடுத்தல்",
 "denomProfiles/international-churches-of-christ/coreDoctrines/1": "பாவமன்னிப்புக்கான ஞானஸ்நானம்",
 "denomProfiles/international-churches-of-christ/coreDoctrines/2": "உண்மையான கிறிஸ்தவரின் அடையாளமாகச் சீஷத்துவம்",
 "denomProfiles/international-churches-of-christ/coreDoctrines/3": "வாராந்திரத் திருவிருந்து",
 "denomProfiles/international-churches-of-christ/coreDoctrines/4": "உள்ளூர்ச் சபைகளின் சுயாட்சி",
 "denomProfiles/international-churches-of-christ/focuses/0": "நற்செய்திப் பணியும் சபை நாட்டுதலும்",
 "denomProfiles/international-churches-of-christ/focuses/1": "கல்லூரி வளாக ஊழியம்",
 "denomProfiles/international-churches-of-christ/focuses/2": "தனிப்பட்ட சீஷத்துவம்",
 "denomProfiles/international-churches-of-christ/focuses/3": "HOPE worldwide மூலம் தொண்டுப் பணி",
 "denomProfiles/international-churches-of-christ/practices/0": "ஞானஸ்நானத்திற்கு முன் தனிப்பட்ட வேதாகமப் படிப்புகள்",
 "denomProfiles/international-churches-of-christ/practices/1": "சீஷத்துவப் பங்காளிகள்",
 "denomProfiles/international-churches-of-christ/practices/2": "வாராந்திரத் திருவிருந்து",
 "denomProfiles/international-churches-of-christ/practices/3": "வாரநடுவில் சிறு குழுக்கள்",
 "denomProfiles/international-churches-of-christ/influenced/0/name": "சர்வதேச கிறிஸ்தவ சபை",
 "denomProfiles/international-churches-of-christ/influenced/0/text": "2006-இல் கிப் மெக்கீன் ஒரு தனிக் குழுவாக நிறுவினார்.",
 "denomProfiles/international-churches-of-christ/influenced/1/name": "ஆவிக்குரிய துஷ்பிரயோகம் பற்றிய விவாதம்",
 "denomProfiles/international-churches-of-christ/influenced/1/text": "அதன் ஆரம்பகால வரலாறு, உறுப்பினர்களிடம் மிகுந்த கோரிக்கை வைக்கும் சபை நடைமுறைகள் பற்றிய முக்கிய ஆய்வு எடுத்துக்காட்டானது.",
 "denomProfiles/international-churches-of-christ/keyFigures/0/name": "கிப் மெக்கீன்",
 "denomProfiles/international-churches-of-christ/keyFigures/0/role": "நிறுவனரும் 2001 வரை தலைவரும்.",
 "denomProfiles/international-churches-of-christ/keyFigures/1/name": "சக் லூக்காஸ்",
 "denomProfiles/international-churches-of-christ/keyFigures/1/role": "கிராஸ்ரோட்ஸ் கிறிஸ்துவின் சபையின் ஊழியர்.",
 "denomProfiles/international-churches-of-christ/keyFigures/2/name": "ஹென்றி கிரீட்",
 "denomProfiles/international-churches-of-christ/keyFigures/2/role": "2003-இல் எழுதிய கடிதத்தின் மூலம் சீர்திருத்தத்தைத் தூண்டிய தலைவர்.",
 "denomProfiles/international-churches-of-christ/inIndia": "ICOC சபைகள் மும்பை, டெல்லி, சென்னை, பெங்களூரு உள்ளிட்ட பல முக்கிய இந்திய நகரங்களில், முக்கியமாக மாணவர்கள் மற்றும் இளம் தொழில்முறையாளர்களிடையே கூடுகின்றன.",
 "denomProfiles/congregacao-crista-no-brasil/tagline": "பிரேசிலின் மிகப் பழைய பெந்தெகொஸ்தே சபை: ஊதியமில்லா மூப்பர்கள், இசைக்குழுக்கள், விளம்பரம் இல்லை.",
 "denomProfiles/congregacao-crista-no-brasil/coreDoctrines/0": "விசுவாசத்தின் மூலம் கிருபையினால் இரட்சிப்பு",
 "denomProfiles/congregacao-crista-no-brasil/coreDoctrines/1": "தேவனுடைய தெரிந்தெடுப்பு",
 "denomProfiles/congregacao-crista-no-brasil/coreDoctrines/2": "அந்நியபாஷை பேசுதலுடன் கூடிய பரிசுத்த ஆவியின் அபிஷேகம்",
 "denomProfiles/congregacao-crista-no-brasil/coreDoctrines/3": "முழுக்கின் மூலம் விசுவாசியின் ஞானஸ்நானம்",
 "denomProfiles/congregacao-crista-no-brasil/coreDoctrines/4": "பரிசுத்தமும் உலகப்பற்றிலிருந்து பிரிந்திருத்தலும்",
 "denomProfiles/congregacao-crista-no-brasil/focuses/0": "எளிய, ஊதியமில்லா ஊழியம்",
 "denomProfiles/congregacao-crista-no-brasil/focuses/1": "பயபக்தியுள்ள ஆராதனை",
 "denomProfiles/congregacao-crista-no-brasil/focuses/2": "சமூகத்திற்குள் பரஸ்பர உதவி",
 "denomProfiles/congregacao-crista-no-brasil/focuses/3": "வாழ்வின் பரிசுத்தம்",
 "denomProfiles/congregacao-crista-no-brasil/practices/0": "ஆண்களும் பெண்களும் தனித்தனியே அமர்கின்றனர்; பெண்கள் முக்காடு அணிகின்றனர்",
 "denomProfiles/congregacao-crista-no-brasil/practices/1": "ஒரே பாலின உறுப்பினர்களுக்கிடையே பரிசுத்த முத்தம்",
 "denomProfiles/congregacao-crista-no-brasil/practices/2": "வருடாந்திரப் பரிசுத்த இராப்போஜனம்",
 "denomProfiles/congregacao-crista-no-brasil/practices/3": "ஆராதனைகளில் இசைக்குழு இசை",
 "denomProfiles/congregacao-crista-no-brasil/influenced/0/name": "இத்தாலியப் பெந்தெகொஸ்தே சபைகள்",
 "denomProfiles/congregacao-crista-no-brasil/influenced/0/text": "பிரான்செஸ்கோனின் வட்டாரம் அமெரிக்கா, இத்தாலி, அர்ஜென்டினா ஆகிய இடங்களிலும் இத்தாலியர்களிடையே சபைகளைத் தொடங்கியது.",
 "denomProfiles/congregacao-crista-no-brasil/influenced/1/name": "பிரேசிலியப் பெந்தெகொஸ்தே இயக்கம்",
 "denomProfiles/congregacao-crista-no-brasil/influenced/1/text": "பிரேசிலின் முதல் பெந்தெகொஸ்தே சபையாக (1911 முதல் அசெம்பிளீஸ் ஆஃப் காட் சபையுடன் சேர்ந்து) அது பிற்கால வளர்ச்சிக்கு வழிதிறந்தது.",
 "denomProfiles/congregacao-crista-no-brasil/keyFigures/0/name": "லூயிஸ் பிரான்செஸ்கோன்",
 "denomProfiles/congregacao-crista-no-brasil/keyFigures/0/role": "நிறுவனர் (1910).",
 "denomProfiles/congregacao-crista-no-brasil/keyFigures/1/name": "ஜியாகோமோ லொம்பார்டி",
 "denomProfiles/congregacao-crista-no-brasil/keyFigures/1/role": "பிரான்செஸ்கோனுடன் அர்ஜென்டினாவுக்கும் பிரேசிலுக்கும் சென்ற உடன் ஊழியர்.",
 "denomProfiles/congregacao-crista-no-brasil/members/note": "பிரேசில் தேசிய மக்கள்தொகைக் கணக்கெடுப்பு (IBGE), 2010.",
 "denomProfiles/church-of-pentecost-ghana/tagline": "அப்போஸ்தலர்களாலும் பொது மூப்பர்களாலும் வழிநடத்தப்படும், சுயநிதியில் இயங்கும் கானாவின் மிகப்பெரிய பெந்தெகொஸ்தே சபை.",
 "denomProfiles/church-of-pentecost-ghana/coreDoctrines/0": "அந்நியபாஷை பேசுதலுடன் கூடிய பரிசுத்த ஆவியின் அபிஷேகம்",
 "denomProfiles/church-of-pentecost-ghana/coreDoctrines/1": "தெய்வீக சுகமளித்தல்",
 "denomProfiles/church-of-pentecost-ghana/coreDoctrines/2": "அப்போஸ்தலர், தீர்க்கதரிசிகள், சுவிசேஷகர், போதகர், போதகர்கள் (ஆசிரியர்கள்) என்ற ஐந்து மடங்கு ஊழியம்",
 "denomProfiles/church-of-pentecost-ghana/coreDoctrines/3": "வாழ்வின் பரிசுத்தம்",
 "denomProfiles/church-of-pentecost-ghana/coreDoctrines/4": "ஆயிரவருட அரசாட்சிக்கு முந்தைய கிறிஸ்துவின் வருகை",
 "denomProfiles/church-of-pentecost-ghana/focuses/0": "நற்செய்திப் பணியும் சபை நாட்டுதலும்",
 "denomProfiles/church-of-pentecost-ghana/focuses/1": "உறுப்பினர்களின் சீஷத்துவம்",
 "denomProfiles/church-of-pentecost-ghana/focuses/2": "சமூகத்தில் பரிசுத்தமும் ஒழுக்கப் போதனையும்",
 "denomProfiles/church-of-pentecost-ghana/focuses/3": "சமூக சேவைகள், பள்ளிகள், சுகாதாரம்",
 "denomProfiles/church-of-pentecost-ghana/practices/0": "வாராந்திர ஜெபக் கூட்டங்களும் இரவு முழுவதும் ஜெபமும்",
 "denomProfiles/church-of-pentecost-ghana/practices/1": "சுகமளித்தலுக்கும் விடுதலைக்குமான ஜெபம்",
 "denomProfiles/church-of-pentecost-ghana/practices/2": "தசமபாகம் செலுத்துதல்",
 "denomProfiles/church-of-pentecost-ghana/practices/3": "வீட்டுச் செல் கூட்டங்கள்",
 "denomProfiles/church-of-pentecost-ghana/influenced/0/name": "ஆப்பிரிக்கப் புலம்பெயர் சபைகள்",
 "denomProfiles/church-of-pentecost-ghana/influenced/0/text": "அதன் சபைகள் ஐரோப்பாவிலும் வட அமெரிக்காவிலும் உள்ள கானா மக்களுக்கு ஊழியம் செய்கின்றன.",
 "denomProfiles/church-of-pentecost-ghana/influenced/1/name": "கானா பெந்தெகொஸ்தே இயக்கம்",
 "denomProfiles/church-of-pentecost-ghana/influenced/1/text": "அதன் ஒழுங்கும் மிஷனரி வைராக்கியமும் பிற கானா சபைகளை வடிவமைத்தன.",
 "denomProfiles/church-of-pentecost-ghana/keyFigures/0/name": "ஜேம்ஸ் மெக்கியோன்",
 "denomProfiles/church-of-pentecost-ghana/keyFigures/0/role": "நிறுவனரும் முதல் தலைவரும் (1937–1982).",
 "denomProfiles/church-of-pentecost-ghana/keyFigures/1/name": "ஓபோகு ஒனியினா",
 "denomProfiles/church-of-pentecost-ghana/keyFigures/1/role": "தலைவர் 2008–2018; பெந்தெகொஸ்தே பேயோட்டுதல் பற்றிய அறிஞர்.",
 "denomProfiles/church-of-pentecost-ghana/keyFigures/2/name": "எரிக் நியாமெக்யே",
 "denomProfiles/church-of-pentecost-ghana/keyFigures/2/role": "2018 முதல் தலைவர்.",
 "denomProfiles/deeper-christian-life-ministry/tagline": "வேதாகமப் படிப்பையும் கண்டிப்பான பரிசுத்தமாக்கப்படுதலையும் வலியுறுத்தும் நைஜீரியப் பரிசுத்த-பெந்தெகொஸ்தே சபை.",
 "denomProfiles/deeper-christian-life-ministry/coreDoctrines/0": "மனந்திரும்புதலும் விசுவாசமும் மூலம் இரட்சிப்பு",
 "denomProfiles/deeper-christian-life-ministry/coreDoctrines/1": "முழுமையான பரிசுத்தமாக்கப்படுதல்",
 "denomProfiles/deeper-christian-life-ministry/coreDoctrines/2": "பரிசுத்த ஆவியின் அபிஷேகம்",
 "denomProfiles/deeper-christian-life-ministry/coreDoctrines/3": "தெய்வீக சுகமளித்தல்",
 "denomProfiles/deeper-christian-life-ministry/coreDoctrines/4": "எடுத்துக்கொள்ளப்படுதலும் கிறிஸ்துவின் வருகையும்",
 "denomProfiles/deeper-christian-life-ministry/focuses/0": "ஒழுங்குமுறையான வேதாகமப் போதனை",
 "denomProfiles/deeper-christian-life-ministry/focuses/1": "வாழ்வின் பரிசுத்தம்",
 "denomProfiles/deeper-christian-life-ministry/focuses/2": "நற்செய்திப் பணியும் சுவிசேஷப் பெருங்கூட்டங்களும்",
 "denomProfiles/deeper-christian-life-ministry/focuses/3": "கல்லூரி வளாக மற்றும் இளைஞர் ஊழியம்",
 "denomProfiles/deeper-christian-life-ministry/practices/0": "திங்கள்கிழமை வேதாகமப் படிப்புகள்",
 "denomProfiles/deeper-christian-life-ministry/practices/1": "வியாழக்கிழமை அற்புத மற்றும் எழுப்புதல் ஆராதனைகள்",
 "denomProfiles/deeper-christian-life-ministry/practices/2": "வீட்டு ஐக்கியங்கள்",
 "denomProfiles/deeper-christian-life-ministry/practices/3": "தியான முகாம்களும் மாநாடுகளும்",
 "denomProfiles/deeper-christian-life-ministry/influenced/0/name": "நைஜீரியக் கல்லூரி வளாக ஊழியங்கள்",
 "denomProfiles/deeper-christian-life-ministry/influenced/0/text": "அதன் வேதாகமப் படிப்புகள் 1970கள் மற்றும் 1980களில் மாணவர் கிறிஸ்தவத்தின் மீது செல்வாக்குச் செலுத்தின.",
 "denomProfiles/deeper-christian-life-ministry/influenced/1/name": "நைஜீரியப் பரிசுத்த இயக்கச் சபைகள்",
 "denomProfiles/deeper-christian-life-ministry/influenced/1/text": "அதன் கண்டிப்பான ஒழுக்கநெறி, பரிசுத்தத்தை நாடும் பிற சபைகளை வடிவமைத்தது.",
 "denomProfiles/deeper-christian-life-ministry/keyFigures/0/name": "வில்லியம் எஃப். குமுயி",
 "denomProfiles/deeper-christian-life-ministry/keyFigures/0/role": "நிறுவனரும் பொதுக் கண்காணிப்பாளரும்.",
 "denomProfiles/apostolic-faith-mission-south-africa/tagline": "லேக்கின் 1908 மிஷன் முதல் இனவொதுக்கலுக்குப் பிந்தைய ஒற்றுமை வரை — தென்னாப்பிரிக்காவின் முன்னோடிப் பெந்தெகொஸ்தே சபை.",
 "denomProfiles/apostolic-faith-mission-south-africa/coreDoctrines/0": "கிறிஸ்துவில் விசுவாசத்தின் மூலம் இரட்சிப்பு",
 "denomProfiles/apostolic-faith-mission-south-africa/coreDoctrines/1": "பரிசுத்த ஆவியின் அபிஷேகம்",
 "denomProfiles/apostolic-faith-mission-south-africa/coreDoctrines/2": "தெய்வீக சுகமளித்தல்",
 "denomProfiles/apostolic-faith-mission-south-africa/coreDoctrines/3": "முழுக்கின் மூலம் விசுவாசியின் ஞானஸ்நானம்",
 "denomProfiles/apostolic-faith-mission-south-africa/coreDoctrines/4": "கிறிஸ்துவின் வருகை",
 "denomProfiles/apostolic-faith-mission-south-africa/focuses/0": "நற்செய்திப் பணி",
 "denomProfiles/apostolic-faith-mission-south-africa/focuses/1": "சுகமளிக்கும் ஊழியம்",
 "denomProfiles/apostolic-faith-mission-south-africa/focuses/2": "இனவொதுக்கலுக்குப் பின் இன ஒப்புரவு",
 "denomProfiles/apostolic-faith-mission-south-africa/focuses/3": "இறையியல் பயிற்சி",
 "denomProfiles/apostolic-faith-mission-south-africa/practices/0": "நோயாளிகளுக்கான ஜெபம்",
 "denomProfiles/apostolic-faith-mission-south-africa/practices/1": "முழுக்கு ஞானஸ்நானம்",
 "denomProfiles/apostolic-faith-mission-south-africa/practices/2": "அந்நியபாஷை பேசுதல்",
 "denomProfiles/apostolic-faith-mission-south-africa/practices/3": "எழுப்புதல் கூட்டங்கள்",
 "denomProfiles/apostolic-faith-mission-south-africa/influenced/0/name": "சீயோன் கிறிஸ்தவத் திருச்சபை",
 "denomProfiles/apostolic-faith-mission-south-africa/influenced/0/text": "எங்கனாஸ் லெக்கன்யானே ZCC-ஐ நிறுவுவதற்கு முன் சீயோனிய மற்றும் AFM-உடன் தொடர்புடைய வட்டாரங்கள் வழியாகக் கடந்து வந்தார்.",
 "denomProfiles/apostolic-faith-mission-south-africa/influenced/1/name": "ஆப்பிரிக்காவில் தோன்றிய திருச்சபைகள்",
 "denomProfiles/apostolic-faith-mission-south-africa/influenced/1/text": "பல சீயோனிய சபைகள் ஆரம்பகால AFM பணியிலிருந்து தோன்றின.",
 "denomProfiles/apostolic-faith-mission-south-africa/influenced/2/name": "கரிஸ்மாட்டிக் புதுப்பித்தல்",
 "denomProfiles/apostolic-faith-mission-south-africa/influenced/2/text": "டேவிட் டு பிளெசிஸ் பெந்தெகொஸ்தே அனுபவத்தை வரலாற்றுத் திருச்சபைகளுக்குக் கொண்டு சென்றார்.",
 "denomProfiles/apostolic-faith-mission-south-africa/keyFigures/0/name": "ஜான் ஜி. லேக்",
 "denomProfiles/apostolic-faith-mission-south-africa/keyFigures/0/role": "அமெரிக்க மிஷனரியும் இணை நிறுவனரும் (1908).",
 "denomProfiles/apostolic-faith-mission-south-africa/keyFigures/1/name": "பீட்டர் எல். லெ ரூ",
 "denomProfiles/apostolic-faith-mission-south-africa/keyFigures/1/role": "முதல் தென்னாப்பிரிக்கத் தலைவர் (1913–1943).",
 "denomProfiles/apostolic-faith-mission-south-africa/keyFigures/2/name": "டேவிட் டு பிளெசிஸ்",
 "denomProfiles/apostolic-faith-mission-south-africa/keyFigures/2/role": "பொதுச் செயலாளர்; பின்னர் கிறிஸ்தவ ஒருமைப்பாட்டுப் பெந்தெகொஸ்தே பேச்சாளர்.",
 "denomProfiles/apostolic-faith-mission-south-africa/keyFigures/3/name": "ஃபிராங்க் சிக்கானே",
 "denomProfiles/apostolic-faith-mission-south-africa/keyFigures/3/role": "AFM போதகரும் இனவொதுக்கல் எதிர்ப்புத் திருச்சபைத் தலைவரும்.",
 "denomProfiles/evangelical-lutheran-church-tanzania/tagline": "தன் ஆயர்கள், மருத்துவமனைகள், பாடகர் குழுக்களுக்குப் பெயர்பெற்ற ஒரு பெரிய கிழக்கு ஆப்பிரிக்க லூத்தரன் திருச்சபை.",
 "denomProfiles/evangelical-lutheran-church-tanzania/coreDoctrines/0": "விசுவாசத்தின் மூலம் கிருபையினால் நீதிமானாக்கப்படுதல்",
 "denomProfiles/evangelical-lutheran-church-tanzania/coreDoctrines/1": "வேதாகமத்தின் அதிகாரம்",
 "denomProfiles/evangelical-lutheran-church-tanzania/coreDoctrines/2": "திருவிருந்தில் மெய்ப்பிரசன்னம்",
 "denomProfiles/evangelical-lutheran-church-tanzania/coreDoctrines/3": "குழந்தை ஞானஸ்நானம்",
 "denomProfiles/evangelical-lutheran-church-tanzania/coreDoctrines/4": "லூத்தரன் விசுவாச அறிக்கைகள்",
 "denomProfiles/evangelical-lutheran-church-tanzania/focuses/0": "நற்செய்திப் பணி",
 "denomProfiles/evangelical-lutheran-church-tanzania/focuses/1": "சுகாதாரமும் கல்வியும்",
 "denomProfiles/evangelical-lutheran-church-tanzania/focuses/2": "மேம்பாட்டுப் பணி",
 "denomProfiles/evangelical-lutheran-church-tanzania/focuses/3": "இறையியல் பயிற்சி",
 "denomProfiles/evangelical-lutheran-church-tanzania/practices/0": "சுவாஹிலி மொழியில் லூத்தரன் வழிபாட்டு முறை",
 "denomProfiles/evangelical-lutheran-church-tanzania/practices/1": "சபைப் பாடகர் குழுக்கள்",
 "denomProfiles/evangelical-lutheran-church-tanzania/practices/2": "உறுதிப்பூசுதல்",
 "denomProfiles/evangelical-lutheran-church-tanzania/practices/3": "எழுப்புதல் ஐக்கியங்கள்",
 "denomProfiles/evangelical-lutheran-church-tanzania/influenced/0/name": "லூத்தரன் உலகக் கூட்டமைப்பு",
 "denomProfiles/evangelical-lutheran-church-tanzania/influenced/0/text": "ஜோசையா கிபிரா உள்ளிட்ட அதன் தலைவர்கள் இக்கூட்டமைப்பில் ஆப்பிரிக்கக் குரலை ஒலிக்கச் செய்தனர்.",
 "denomProfiles/evangelical-lutheran-church-tanzania/influenced/1/name": "ஆப்பிரிக்க லூத்தரன் திருச்சபைகள்",
 "denomProfiles/evangelical-lutheran-church-tanzania/influenced/1/text": "அது அண்டை நாடுகளில் லூத்தரன் பணிக்கு ஆதரவளிக்கிறது.",
 "denomProfiles/evangelical-lutheran-church-tanzania/keyFigures/0/name": "ஸ்டெஃபானோ மோஷி",
 "denomProfiles/evangelical-lutheran-church-tanzania/keyFigures/0/role": "ஒன்றிணைந்த திருச்சபையின் முதல் தலைமை ஆயர்.",
 "denomProfiles/evangelical-lutheran-church-tanzania/keyFigures/1/name": "ஜோசையா கிபிரா",
 "denomProfiles/evangelical-lutheran-church-tanzania/keyFigures/1/role": "புகோபாவின் ஆயரும் லூத்தரன் உலகக் கூட்டமைப்பின் தலைவரும் (1977–1984)."
}
