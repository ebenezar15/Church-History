{
 "denomProfiles/believers-eastern-church/tagline": "கிழக்கத்திய ஆயர்முறையையும் வழிபாட்டு முறையையும் ஏற்றுக்கொண்ட, கேரளத்திலிருந்து தோன்றிய சுவிசேஷ மிஷன் திருச்சபை.",
 "denomProfiles/believers-eastern-church/coreDoctrines/0": "நிசேயா திரித்துவ விசுவாசமும் சுவிசேஷ மனமாற்றமும்",
 "denomProfiles/believers-eastern-church/coreDoctrines/1": "வேதாகமத்தின் உன்னத அதிகாரம்",
 "denomProfiles/believers-eastern-church/coreDoctrines/2": "பண்டைய திருச்சபைகளுடன் தொடர்ச்சி கொண்ட ஆயர்முறை",
 "denomProfiles/believers-eastern-church/coreDoctrines/3": "நற்செய்தி சென்றடையாத மக்களுக்கு நற்செய்தி அறிவிப்பதன் அவசரம்",
 "denomProfiles/believers-eastern-church/focuses/0": "சுதேச மிஷனரிகளைப் பயிற்றுவித்து ஆதரித்தல்",
 "denomProfiles/believers-eastern-church/focuses/1": "வட இந்தியாவில் கிராமப்புறச் சபை நாட்டுதல்",
 "denomProfiles/believers-eastern-church/focuses/2": "மருத்துவம், கல்வி மற்றும் குழந்தைகள் நலப் பணி",
 "denomProfiles/believers-eastern-church/practices/0": "கிழக்கத்திய பாணி திருவுடைகளுடன் பரிசுத்த குர்பானா",
 "denomProfiles/believers-eastern-church/practices/1": "ஆயர் அபிஷேகங்களும் மறைமாவட்ட அமைப்பும்",
 "denomProfiles/believers-eastern-church/practices/2": "மிஷனரிப் பயிற்சிக் கல்லூரிகள்",
 "denomProfiles/believers-eastern-church/influenced/0/name": "சுதேச மிஷன் இயக்கம்",
 "denomProfiles/believers-eastern-church/influenced/0/text": "அதன் சுதேச மிஷனரி மாதிரி மேற்கத்திய ஆதரவு நிறுவனங்களால் பரவலாகப் பின்பற்றப்பட்டது.",
 "denomProfiles/believers-eastern-church/keyFigures/0/name": "கே. பி. யோகன்னான் (அத்தனாசியஸ் யோகன் I)",
 "denomProfiles/believers-eastern-church/keyFigures/0/role": "நிறுவனரும் முதல் பெருநகர ஆயரும் (Metropolitan), 2003–2024",
 "denomProfiles/believers-eastern-church/keyFigures/1/name": "சாமுவேல் மோர் தியோஃபிலஸ்",
 "denomProfiles/believers-eastern-church/keyFigures/1/role": "2024-இல் தேர்ந்தெடுக்கப்பட்ட இரண்டாம் பெருநகர ஆயர்",
 "denomProfiles/believers-eastern-church/inIndia": "கேரளத்தின் திருவல்லாவைத் தலைமையகமாகக் கொண்டு, வட மற்றும் தென்னிந்தியா முழுவதும் மறைமாவட்டங்களைக் கொண்டுள்ளது; அதன் மருத்துவக் கல்லூரி மருத்துவமனை மத்திய திருவிதாங்கூரில் ஒரு முக்கிய நிறுவனமாகும்.",
 "denomProfiles/st-thomas-evangelical-church/tagline": "1961-இல் உருவான, மார்த்தோமா திருச்சபையிலிருந்து பிரிந்த கேரளத்தின் சுவிசேஷக் கிளை.",
 "denomProfiles/st-thomas-evangelical-church/coreDoctrines/0": "மரபுக்கு மேலான வேதாகமத்தின் அதிகாரம்",
 "denomProfiles/st-thomas-evangelical-church/coreDoctrines/1": "விசுவாசத்தினால் நீதிமானாக்கப்படுதல்",
 "denomProfiles/st-thomas-evangelical-church/coreDoctrines/2": "நற்செய்தி சார்ந்த இரண்டு அருட்சாதனங்கள்",
 "denomProfiles/st-thomas-evangelical-church/coreDoctrines/3": "நிசேயா திரித்துவ விசுவாசம்",
 "denomProfiles/st-thomas-evangelical-church/focuses/0": "நற்செய்திப் பணியும் எழுப்புதல் மாநாடுகளும்",
 "denomProfiles/st-thomas-evangelical-church/focuses/1": "சீர்திருத்தத்திற்கு முந்தைய சடங்குகளுக்குத் திரும்புதல் என்று அது கருதுவதற்கு எதிராக எச்சரிக்கையாக இருத்தல்",
 "denomProfiles/st-thomas-evangelical-church/focuses/2": "வட இந்தியாவில் மிஷன் பணி",
 "denomProfiles/st-thomas-evangelical-church/practices/0": "மலையாளத்தில் சீர்திருத்தப்பட்ட மலங்கரா வழிபாட்டு முறை",
 "denomProfiles/st-thomas-evangelical-church/practices/1": "வருடாந்திர மாநாடுகள்",
 "denomProfiles/st-thomas-evangelical-church/practices/2": "ஆயர் மூலம் அபிஷேகம்",
 "denomProfiles/st-thomas-evangelical-church/keyFigures/0/name": "கே. என். டேனியல்",
 "denomProfiles/st-thomas-evangelical-church/keyFigures/0/role": "பிரிவினைக்கு முன் வழக்குத் தொடர்ந்த பொதுநிலைத் தலைவர்",
 "denomProfiles/st-thomas-evangelical-church/keyFigures/1/name": "ஆபிரகாம் சாக்கோ",
 "denomProfiles/st-thomas-evangelical-church/keyFigures/1/role": "2020-களில் தலைமை ஆயர்",
 "denomProfiles/st-thomas-evangelical-church/inIndia": "கேரளத்தின் திருவல்லா மஞ்சாடியை மையமாகக் கொண்டு, இந்தியாவின் பிற பகுதிகளில் உள்ள மலையாளிகளிடையேயும் சபைகளைக் கொண்டுள்ளது; விக்கிப்பீடியா 350-க்கும் மேற்பட்ட சபைகள் என்று குறிப்பிடுகிறது.",
 "denomProfiles/tamil-evangelical-lutheran-church/tagline": "சீகன்பால்குவின் 1706 தரங்கம்பாடி மிஷனில் வேரூன்றிய தமிழ்நாட்டின் லூத்தரன் திருச்சபை.",
 "denomProfiles/tamil-evangelical-lutheran-church/coreDoctrines/0": "விசுவாசத்தினால் மட்டுமே நீதிமானாக்கப்படுதல்",
 "denomProfiles/tamil-evangelical-lutheran-church/coreDoctrines/1": "ஆக்ஸ்பர்க் விசுவாச அறிக்கையும் சிறிய ஞானோபதேசமும்",
 "denomProfiles/tamil-evangelical-lutheran-church/coreDoctrines/2": "திருவிருந்தில் கிறிஸ்துவின் மெய்யான பிரசன்னம்",
 "denomProfiles/tamil-evangelical-lutheran-church/coreDoctrines/3": "குழந்தை ஞானஸ்நானம்",
 "denomProfiles/tamil-evangelical-lutheran-church/focuses/0": "தமிழ்க் கிறிஸ்தவக் கல்வியும் இலக்கியமும்",
 "denomProfiles/tamil-evangelical-lutheran-church/focuses/1": "கிராமச் சபைகளின் ஆயர்ப் பராமரிப்பு",
 "denomProfiles/tamil-evangelical-lutheran-church/focuses/2": "பள்ளிகள் மற்றும் மருத்துவமனைகள் மூலம் சமூக சேவை",
 "denomProfiles/tamil-evangelical-lutheran-church/practices/0": "தமிழ் லூத்தரன் வழிபாட்டு முறை",
 "denomProfiles/tamil-evangelical-lutheran-church/practices/1": "ஞானோபதேசத்திலிருந்து உறுதிப்படுத்துதலுக்கான போதனை",
 "denomProfiles/tamil-evangelical-lutheran-church/practices/2": "தமிழ்க் கீர்த்தனைகளைப் பாடுதல்",
 "denomProfiles/tamil-evangelical-lutheran-church/influenced/0/name": "தென்னிந்தியத் திருச்சபை",
 "denomProfiles/tamil-evangelical-lutheran-church/influenced/0/text": "தரங்கம்பாடி மிஷனிலிருந்து வந்த தமிழ் புராட்டஸ்டன்ட் மரபுகள், பின்னர் CSI-இல் இணைந்த சபைகள் உட்பட, பரந்த தமிழ்த் திருச்சபைக்கு ஊட்டமளித்தன.",
 "denomProfiles/tamil-evangelical-lutheran-church/influenced/1/name": "தமிழ் வேதாகம மொழிபெயர்ப்பு",
 "denomProfiles/tamil-evangelical-lutheran-church/influenced/1/text": "சீகன்பால்குவின் 1714 புதிய ஏற்பாடு தமிழ் புராட்டஸ்டன்ட் வேதாகம மரபைத் தொடங்கிவைத்தது.",
 "denomProfiles/tamil-evangelical-lutheran-church/keyFigures/0/name": "பர்த்தலோமேயு சீகன்பால்கு",
 "denomProfiles/tamil-evangelical-lutheran-church/keyFigures/0/role": "தரங்கம்பாடியில் முன்னோடி மிஷனரி (1706–1719)",
 "denomProfiles/tamil-evangelical-lutheran-church/keyFigures/1/name": "கிறிஸ்டியன் ஃபிரெட்ரிக் சுவார்ட்ஸ்",
 "denomProfiles/tamil-evangelical-lutheran-church/keyFigures/1/role": "திருச்சிராப்பள்ளியிலும் தஞ்சாவூரிலும் மிஷனரி",
 "denomProfiles/tamil-evangelical-lutheran-church/keyFigures/2/name": "ராஜா பி. மாணிக்கம்",
 "denomProfiles/tamil-evangelical-lutheran-church/keyFigures/2/role": "முதல் இந்திய ஆயர் (1956)",
 "denomProfiles/tamil-evangelical-lutheran-church/inIndia": "திருச்சிராப்பள்ளியைத் தளமாகக் கொண்டு, தமிழ்நாட்டின் தஞ்சாவூர், தரங்கம்பாடி, கடலூர் மாவட்டங்களில் மிக வலுவாக உள்ளது; ஆசியாவின் மிகப் பழமையான புராட்டஸ்டன்ட் திருச்சபைகளில் இதுவும் ஒன்று.",
 "denomProfiles/andhra-evangelical-lutheran-church/tagline": "குண்டூரில் ஃபாதர் ஹேயரின் 1842 மிஷனிலிருந்து பிறந்த, இந்தியாவின் மிகப்பெரிய லூத்தரன் திருச்சபை.",
 "denomProfiles/andhra-evangelical-lutheran-church/coreDoctrines/0": "விசுவாசத்தினால் மட்டுமே நீதிமானாக்கப்படுதல்",
 "denomProfiles/andhra-evangelical-lutheran-church/coreDoctrines/1": "ஆக்ஸ்பர்க் விசுவாச அறிக்கை",
 "denomProfiles/andhra-evangelical-lutheran-church/coreDoctrines/2": "நற்கருணையில் கிறிஸ்துவின் மெய்யான பிரசன்னம்",
 "denomProfiles/andhra-evangelical-lutheran-church/coreDoctrines/3": "குழந்தை ஞானஸ்நானம்",
 "denomProfiles/andhra-evangelical-lutheran-church/focuses/0": "கல்வி மூலம் தலித் மக்களின் முன்னேற்றம்",
 "denomProfiles/andhra-evangelical-lutheran-church/focuses/1": "கிராமப்புற ஆயர் ஊழியம்",
 "denomProfiles/andhra-evangelical-lutheran-church/focuses/2": "மருத்துவப் பணி",
 "denomProfiles/andhra-evangelical-lutheran-church/practices/0": "தெலுங்கு வழிபாட்டு முறை",
 "denomProfiles/andhra-evangelical-lutheran-church/practices/1": "உறுதிப்படுத்துதல்",
 "denomProfiles/andhra-evangelical-lutheran-church/practices/2": "பெரிய கிராமச் சபைகள்",
 "denomProfiles/andhra-evangelical-lutheran-church/influenced/0/name": "இந்திய ஐக்கிய சுவிசேஷ லூத்தரன் திருச்சபைகள்",
 "denomProfiles/andhra-evangelical-lutheran-church/influenced/0/text": "மிகப்பெரிய உறுப்பினர் என்ற முறையில், இந்திய லூத்தரன் ஒத்துழைப்பில் இது பெரும் செல்வாக்குச் செலுத்தியுள்ளது.",
 "denomProfiles/andhra-evangelical-lutheran-church/keyFigures/0/name": "ஜான் கிறிஸ்டியன் ஃபிரெடரிக் ஹேயர்",
 "denomProfiles/andhra-evangelical-lutheran-church/keyFigures/0/role": "தொடக்க மிஷனரி (1842)",
 "denomProfiles/andhra-evangelical-lutheran-church/inIndia": "ஆந்திரப் பிரதேசத்தின் குண்டூர், கிருஷ்ணா, கோதாவரி, பிரகாசம் மாவட்டங்களில் செறிவாக உள்ளது; இது லட்சக்கணக்கில் உறுப்பினர்களைக் கொண்டிருப்பதாக அறிவிக்கிறது, எனினும் வெளியிடப்பட்ட எண்ணிக்கைகள் பெரிதும் வேறுபடுகின்றன.",
 "denomProfiles/indian-brethren/tagline": "1899 கும்பநாடு கூட்டம் முதல் கேரளத்தில் வலுவாக உள்ள, குருக்கள் இல்லாத சகோதரர் சபைகள்.",
 "denomProfiles/indian-brethren/coreDoctrines/0": "அபிஷேகம் பெற்ற குருக்கள் இல்லாத, எல்லா விசுவாசிகளின் ஆசாரியத்துவம்",
 "denomProfiles/indian-brethren/coreDoctrines/1": "முழுக்கு மூலம் விசுவாசிகளின் ஞானஸ்நானம்",
 "denomProfiles/indian-brethren/coreDoctrines/2": "நினைவுகூருதலாக வாராந்திரத் திருவிருந்து",
 "denomProfiles/indian-brethren/coreDoctrines/3": "யுகக்கோட்பாட்டு ஆயிரவருடத்திற்கு முன்வருகைவாதம்",
 "denomProfiles/indian-brethren/focuses/0": "நற்செய்திப் பிரசங்கமும் துண்டுப்பிரசுரப் பணியும்",
 "denomProfiles/indian-brethren/focuses/1": "வேதாகமப் படிப்பும் மாநாடுகளும்",
 "denomProfiles/indian-brethren/focuses/2": "சபைகளால் 'ஒப்புவிக்கப்பட்ட' (commended) ஊழியர்கள் மூலம் வட இந்தியாவில் மிஷன் பணி",
 "denomProfiles/indian-brethren/practices/0": "ஞாயிறு அப்பம் பிட்குதல்",
 "denomProfiles/indian-brethren/practices/1": "பெண்களுக்கு முக்காடு",
 "denomProfiles/indian-brethren/practices/2": "திறந்தவெளி நற்செய்திக் கூட்டங்கள்",
 "denomProfiles/indian-brethren/practices/3": "வருடாந்திர மாநாடுகள்",
 "denomProfiles/indian-brethren/influenced/0/name": "கேரளப் பெந்தெகொஸ்தே இயக்கம்",
 "denomProfiles/indian-brethren/influenced/0/text": "ஆரம்பகாலக் கேரளப் பெந்தெகொஸ்தே தலைவர்களில் பலர் சகோதரர் சபைகளிலிருந்து வந்து, தங்கள் வேதாகமப் படிப்பு முறையைத் தொடர்ந்து கடைப்பிடித்தனர்.",
 "denomProfiles/indian-brethren/influenced/1/name": "சுதேச இந்திய மிஷன்கள்",
 "denomProfiles/indian-brethren/influenced/1/text": "சகோதரர் சபைகளால் ஒப்புவிக்கப்பட்ட ஊழியர்கள் வட இந்தியா முழுவதும் சபைகளை நாட்டினர்.",
 "denomProfiles/indian-brethren/keyFigures/0/name": "ஆண்டனி நோரிஸ் குரோவ்ஸ்",
 "denomProfiles/indian-brethren/keyFigures/0/role": "1833 முதல் இந்தியாவில் சகோதரர் இயக்க முன்னோடி",
 "denomProfiles/indian-brethren/keyFigures/1/name": "வோல்ப்ரெக்ட் நாகல்",
 "denomProfiles/indian-brethren/keyFigures/1/role": "ஜெர்மன் மிஷனரியும் கேரளச் சகோதரர் சபைகளின் முன்னோடியும்",
 "denomProfiles/indian-brethren/keyFigures/2/name": "கே. வி. சைமன்",
 "denomProfiles/indian-brethren/keyFigures/2/role": "மலையாளப் பாடலாசிரியரும் ஆரம்பகாலத் தலைவரும்",
 "denomProfiles/indian-brethren/inIndia": "மத்திய கேரளத்திலும் (கும்பநாடு, திருவல்லா, கோட்டயம்) கடலோர ஆந்திரத்திலும் மிக வலுவாக உள்ளது; கேரளச் சகோதரர் சபைகள் வட இந்தியாவுக்கும் வளைகுடா நாடுகளுக்கும் பல ஊழியர்களை அனுப்பியுள்ளன.",
 "denomProfiles/sharon-fellowship-church/tagline": "இறையியல் பயிற்சிக்குப் பெயர்பெற்ற, பி. ஜே. தாமஸால் நிறுவப்பட்ட திருவல்லா பெந்தெகொஸ்தே திருச்சபை.",
 "denomProfiles/sharon-fellowship-church/coreDoctrines/0": "திரித்துவ பெந்தெகொஸ்தே விசுவாசம்",
 "denomProfiles/sharon-fellowship-church/coreDoctrines/1": "அந்நியபாஷையால் உறுதிப்படுத்தப்படும் ஆவியின் ஞானஸ்நானம்",
 "denomProfiles/sharon-fellowship-church/coreDoctrines/2": "தெய்வீக சுகமளித்தல்",
 "denomProfiles/sharon-fellowship-church/coreDoctrines/3": "ஆயிர வருட அரசாட்சிக்கு முந்தைய கிறிஸ்துவின் வருகை",
 "denomProfiles/sharon-fellowship-church/focuses/0": "ஊழியப் பயிற்சி",
 "denomProfiles/sharon-fellowship-church/focuses/1": "கேரளத்திலும் வட இந்தியாவிலும் நற்செய்திப் பணி",
 "denomProfiles/sharon-fellowship-church/focuses/2": "மாநாடுகள்",
 "denomProfiles/sharon-fellowship-church/practices/0": "முழுக்கு மூலம் விசுவாசிகளின் ஞானஸ்நானம்",
 "denomProfiles/sharon-fellowship-church/practices/1": "திருவிருந்து",
 "denomProfiles/sharon-fellowship-church/practices/2": "வருடாந்திர சாரோன் மாநாடு",
 "denomProfiles/sharon-fellowship-church/influenced/0/name": "ஃபெய்த் இறையியல் கல்லூரி (Faith Theological Seminary)",
 "denomProfiles/sharon-fellowship-church/influenced/0/text": "சாரோனின் இணை நிறுவனரான டி. ஜி. கோஷியால் நிறுவப்பட்ட இக்கல்லூரி, பல கேரளச் சுவிசேஷத் தலைவர்களுக்குப் பயிற்சியளித்தது.",
 "denomProfiles/sharon-fellowship-church/keyFigures/0/name": "பி. ஜே. தாமஸ்",
 "denomProfiles/sharon-fellowship-church/keyFigures/0/role": "நிறுவனர் (1914–1998)",
 "denomProfiles/sharon-fellowship-church/keyFigures/1/name": "டி. ஜி. கோஷி",
 "denomProfiles/sharon-fellowship-church/keyFigures/1/role": "இணை நிறுவனர்; பின்னர் ஃபெய்த் இறையியல் கல்லூரியின் நிறுவனர்",
 "denomProfiles/sharon-fellowship-church/inIndia": "கேரளத்தின் திருவல்லாவைத் தலைமையகமாகக் கொண்டு, இந்தியா முழுவதும் வெளிநாடுகளில் உள்ள மலையாளிகளிடையேயும் சபைகளைக் கொண்டுள்ளது.",
 "denomProfiles/church-of-god-full-gospel-india/tagline": "ராபர்ட் எஃப். குக்கால் நிறுவப்பட்ட, கேரளத்தைத் தளமாகக் கொண்ட தேவசபையின் (கிளீவ்லாந்து) இந்தியக் கிளை.",
 "denomProfiles/church-of-god-full-gospel-india/coreDoctrines/0": "தேவசபையின் விசுவாசப் பிரகடனம் (Declaration of Faith)",
 "denomProfiles/church-of-god-full-gospel-india/coreDoctrines/1": "திட்டவட்டமான ஒரு கிரியையாகப் பரிசுத்தமாக்கப்படுதல்",
 "denomProfiles/church-of-god-full-gospel-india/coreDoctrines/2": "அந்நியபாஷையுடன் கூடிய ஆவியின் ஞானஸ்நானம்",
 "denomProfiles/church-of-god-full-gospel-india/coreDoctrines/3": "தெய்வீக சுகமளித்தல்",
 "denomProfiles/church-of-god-full-gospel-india/focuses/0": "கேரளத்திலும் அதற்கு அப்பாலும் நற்செய்திப் பணி",
 "denomProfiles/church-of-god-full-gospel-india/focuses/1": "வேதாகமப் பள்ளிகள்",
 "denomProfiles/church-of-god-full-gospel-india/focuses/2": "தலித் கிறிஸ்தவர்களிடையே ஊழியம்",
 "denomProfiles/church-of-god-full-gospel-india/practices/0": "திருவிருந்துடன் கால் கழுவுதல்",
 "denomProfiles/church-of-god-full-gospel-india/practices/1": "முழுக்கு ஞானஸ்நானம்",
 "denomProfiles/church-of-god-full-gospel-india/practices/2": "முளக்குழாவில் மாநாடுகள்",
 "denomProfiles/church-of-god-full-gospel-india/influenced/0/name": "இந்திய பெந்தெகொஸ்தே தேவசபை",
 "denomProfiles/church-of-god-full-gospel-india/influenced/0/text": "1930-இல் கே. இ. ஆபிரகாம் குக்கிடமிருந்து பிரிந்தது இந்தியாவின் மிகப்பெரிய சுதேசப் பெந்தெகொஸ்தே திருச்சபைக்கு வழிவகுத்தது.",
 "denomProfiles/church-of-god-full-gospel-india/keyFigures/0/name": "ராபர்ட் எஃப். குக்",
 "denomProfiles/church-of-god-full-gospel-india/keyFigures/0/role": "தொடக்க மிஷனரி",
 "denomProfiles/church-of-god-full-gospel-india/inIndia": "கேரளத்தின் முளக்குழாவை மையமாகக் கொண்டு, தமிழ்நாடு மற்றும் பிற மாநிலங்களில் பிராந்திய அமைப்புகளைக் கொண்டுள்ளது."
}
