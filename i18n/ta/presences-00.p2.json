 "presences/p-chennai-1947/note": "ஆங்கிலிக்கன், மெதடிஸ்ட், சீர்திருத்தத் திருச்சபைகளின் ஒன்றிணைப்பு.",
 "presences/p-amsterdam-1948/label": "உலகத் திருச்சபைகள் மன்றம்",
 "presences/p-amsterdam-1948/place/name": "ஆம்ஸ்டர்டாம்",
 "presences/p-amsterdam-1948/note": "உலகத் திருச்சபைகள் மன்றத்தின் நிறுவனப் பேரவை.",
 "presences/p-lagos-rccg-1952/label": "மீட்கப்பட்ட கிறிஸ்தவ தேவசபை, லாகோஸ்",
 "presences/p-lagos-rccg-1952/place/name": "லாகோஸ்",
 "presences/p-lagos-rccg-1952/note": "ஜோசையா அகிண்டயோமியால் நிறுவப்பட்டது; பின்னர் உலகளாவிய நைஜீரியப் பெந்தெகொஸ்தே வலையமைப்பானது.",
 "presences/p-yoido-1958/label": "யோயிடோ முழு நற்செய்தித் திருச்சபை, சியோல்",
 "presences/p-yoido-1958/place/name": "சியோல்",
 "presences/p-yoido-1958/note": "1958-இல் நிறுவப்பட்டது; உலகின் மிகப்பெரிய சபையானது.",
 "presences/p-vatican-ii-1962/label": "இரண்டாம் வத்திக்கான் பொதுச்சங்கம்",
 "presences/p-vatican-ii-1962/place/name": "வத்திக்கான் நகரம்",
 "presences/p-vatican-ii-1962/note": "புதுப்பித்தலுக்கான உலகளாவிய கத்தோலிக்கப் பொதுச்சங்கம்.",
 "presences/p-medellin-1968/label": "மெதெயின்",
 "presences/p-medellin-1968/place/name": "மெதெயின்",
 "presences/p-medellin-1968/note": "இலத்தீன் அமெரிக்க ஆயர்களின் மாநாடு; விடுதலை இறையியல்.",
 "presences/p-lausanne-1974/label": "லோசான் மாநாடு",
 "presences/p-lausanne-1974/place/name": "லோசான்",
 "presences/p-lausanne-1974/note": "உலகளாவிய சுவிசேஷ மாநாடும் லோசான் உடன்படிக்கையும்.",
 "presences/p-toronto-1994/label": "டொரான்டோ விமான நிலைய வைன்யார்ட்",
 "presences/p-toronto-1994/place/name": "டொரான்டோ",
 "presences/p-toronto-1994/note": "டொரான்டோ ஆசீர்வாதம்.",
 "presences/p-brownsville-1995/label": "பிரவுன்ஸ்வில், பென்சகோலா",
 "presences/p-brownsville-1995/place/name": "பென்சகோலா",
 "presences/p-brownsville-1995/note": "பிரவுன்ஸ்வில் எழுப்புதல்.",
 "presences/p-asbury-2023/label": "ஆஸ்பரி பல்கலைக்கழகம்",
 "presences/p-asbury-2023/place/name": "வில்மோர், கென்டக்கி",
 "presences/p-asbury-2023/note": "ஆஸ்பரி எழுப்புதல்.",
 "presences/r-thomas-to-india/label": "எருசலேம்: தோமா இந்தியாவுக்கு (பாரம்பரியம்)",
 "presences/r-thomas-to-india/place/name": "எருசலேம்",
 "presences/r-thomas-to-india/note": "செங்கடல் வர்த்தகப் பாதை வழியாக முசிறிக்கும் மயிலாப்பூருக்கும் அப்போஸ்தலர் தோமா சென்றதாகக் கூறப்படும் பாரம்பரியக் கடல் வழி.",
 "presences/r-paul-first-journey/label": "அந்தியோகியா: பவுலின் முதல் பயணம்",
 "presences/r-paul-first-journey/place/name": "அந்தியோகியா",
 "presences/r-paul-first-journey/note": "பர்னபாவுடன் சீப்புருவுக்கும் தென் கலாத்தியாவுக்கும் (அப்போஸ்தலர் 13–14).",
 "presences/r-paul-second-journey/label": "அந்தியோகியா: பவுலின் இரண்டாம் பயணம்",
 "presences/r-paul-second-journey/place/name": "அந்தியோகியா",
 "presences/r-paul-second-journey/note": "ஐரோப்பாவுக்குள்: பிலிப்பி, தெசலோனிக்கே, அத்தேனே, கொரிந்து (அப்போஸ்தலர் 15:36–18:22).",
 "presences/r-paul-third-journey/label": "அந்தியோகியா: பவுலின் மூன்றாம் பயணம்",
 "presences/r-paul-third-journey/place/name": "அந்தியோகியா",
 "presences/r-paul-third-journey/note": "எபேசு, மக்கெதோனியா, கிரேக்கு, பின்னர் எருசலேமுக்கு (அப்போஸ்தலர் 18:23–21:17).",
 "presences/r-paul-to-rome/label": "செசரியா: பவுலின் ரோம் கடற்பயணம்",
 "presences/r-paul-to-rome/place/name": "செசரியா",
 "presences/r-paul-to-rome/note": "கிரேத்தா வழியாகக் கைதியாகச் சென்ற கடற்பயணமும் மெலித்தா (மால்டா) தீவில் கப்பல் உடைதலும் (அப்போஸ்தலர் 27–28).",
 "presences/r-frumentius-aksum/label": "தீரு: ஃப்ரூமென்டியஸ் அக்சூமுக்கு",
 "presences/r-frumentius-aksum/place/name": "தீரு",
 "presences/r-frumentius-aksum/note": "தீருவிலிருந்து சிறைபிடிக்கப்பட்ட இளைஞர்கள் அக்சூம் அரசவையை அடைகின்றனர்; ஃப்ரூமென்டியஸ் ஆயராகத் திரும்புகிறார்.",
 "presences/r-celtic-iona-lindisfarne/label": "ஆர்மா: அயோனாவுக்கும் நார்தம்பிரியாவுக்கும் கெல்திய மிஷன்",
 "presences/r-celtic-iona-lindisfarne/place/name": "ஆர்மா",
 "presences/r-celtic-iona-lindisfarne/note": "கொலும்பா அயோனாவுக்கு (563); அயோனாவிலிருந்து எய்டன் லிண்டிஸ்ஃபார்னுக்கு (635).",
 "presences/r-columbanus/label": "பாங்கர்: கொலம்பானஸ் ஐரோப்பியக் கண்டத்திற்கு",
 "presences/r-columbanus/place/name": "பாங்கர்",
 "presences/r-columbanus/note": "லக்ஸெய், பிரெகென்ஸ், பொப்பியோ ஆகியவற்றை நிறுவிய ஐரிஷ் புனிதப் பயணம் (peregrinatio).",
 "presences/r-augustine-canterbury/label": "ரோம்: அகஸ்டின் கான்டர்பரிக்கு",
 "presences/r-augustine-canterbury/place/name": "ரோம்",
 "presences/r-augustine-canterbury/note": "மகா கிரகோரியின் ஆங்கிலேயருக்கான மிஷன்.",
 "presences/r-east-syriac-silk-road/label": "செலூக்கியா-டெசிஃபோன்: கிழக்கின் திருச்சபை சீனாவுக்கு",
 "presences/r-east-syriac-silk-road/place/name": "செலூக்கியா-டெசிஃபோன்",
 "presences/r-east-syriac-silk-road/note": "அலோபெனைச் சாங்'ஆனுக்குக் கொண்டுவந்த, கிழக்கு சீரியத் துறவிகளும் வணிகர்களும் பயணித்த பட்டுப் பாதை வழி.",
 "presences/r-cyril-methodius/label": "கான்ஸ்டான்டிநோபிள்: சிரில் மற்றும் மெத்தோடியஸ் மொராவியாவுக்கு",
 "presences/r-cyril-methodius/place/name": "கான்ஸ்டான்டிநோபிள்",
 "presences/r-cyril-methodius/note": "ஸ்லாவ் மக்களுக்கான மிஷனும், ஸ்லாவோனிக் திருவழிபாட்டைப் பாதுகாக்க ரோமுக்கு மேற்கொண்ட பயணமும்.",
 "presences/r-ansgar/label": "ஹாம்பர்க்: அன்ஸ்கர் ஸ்காண்டிநேவியாவுக்கு",
 "presences/r-ansgar/place/name": "ஹாம்பர்க்",
 "presences/r-ansgar/note": "ஹெடெபிக்கும் பிர்க்காவுக்குமான பிராங்கிய மிஷன்.",
 "presences/r-rubruck/label": "கான்ஸ்டான்டிநோபிள்: பிரான்சிஸ்கன் துறவிகள் மங்கோலியரிடம்",
 "presences/r-rubruck/place/name": "கான்ஸ்டான்டிநோபிள்",
 "presences/r-rubruck/note": "காரகோரத்தில் மோங்கே கானிடம் ருப்ரூக்கின் வில்லியம் மேற்கொண்ட பயணம் (வழி தோராயமானது).",
 "presences/r-rabban-sauma/label": "கான்பாலிக்: ரப்பான் சௌமா ஐரோப்பாவுக்கு",
 "presences/r-rabban-sauma/place/name": "கான்பாலிக்",
 "presences/r-rabban-sauma/note": "மேற்கு நோக்கிய புனிதப் பயணமும், கான்ஸ்டான்டிநோபிள், ரோம், பாரிஸ், காஸ்கனி ஆகியவற்றுக்கான தூதுப் பயணமும்.",
 "presences/r-xavier/label": "லிஸ்பன்: பிரான்சிஸ் சவேரியார் ஆசியாவுக்கு",
 "presences/r-xavier/place/name": "லிஸ்பன்",
 "presences/r-xavier/note": "இந்தியா, மொலுக்காஸ், ஜப்பான்; சீனக் கடற்கரைக்கு அப்பால் மரித்தார்.",
 "presences/r-ricci/label": "மக்காவ்: இயேசு சபையினர் பெய்ஜிங்குக்கு",
 "presences/r-ricci/place/name": "மக்காவ்",
 "presences/r-ricci/note": "பேரரசுத் தலைநகருக்கு ரிச்சியின் படிப்படியான பயணம்.",
 "presences/r-moravians/label": "ஹெர்ன்ஹுட்: மொராவிய மிஷன்கள்",
 "presences/r-moravians/place/name": "ஹெர்ன்ஹுட்",
 "presences/r-moravians/note": "டோபரும் நிட்ச்மனும் கோபன்ஹேகன் வழியாகச் செயின்ட் தாமஸுக்குக் கப்பலில் செல்கின்றனர் (1732).",
 "presences/r-carey/label": "டோவர்: வில்லியம் கேரி வங்காளத்திற்கு",
 "presences/r-carey/place/name": "டோவர்",
 "presences/r-carey/note": "நன்னம்பிக்கை முனையைச் சுற்றிக் கல்கத்தாவுக்குக் கடற்பயணம்; 1800-இல் செராம்பூரில் குடியேறினார்.",
 "presences/r-hudson-taylor/label": "லண்டன்: ஹட்சன் டெய்லரின் லாமர்மூர் குழு",
 "presences/r-hudson-taylor/place/name": "லண்டன்",
 "presences/r-hudson-taylor/note": "சீன உள்நாட்டு மிஷன் குழு ஷாங்காய்க்கும் ஹாங்சோவுக்கும் கப்பலில் செல்கிறது."
}
