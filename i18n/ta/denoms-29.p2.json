{
 "denomProfiles/reformed-baptists/tagline": "1689 இரண்டாம் லண்டன் விசுவாச அறிக்கையைப் பின்பற்றும் கால்வினிய பாப்டிஸ்டுகள்.",
 "denomProfiles/reformed-baptists/coreDoctrines/0": "வேதாகமத்தின் போதுமான தன்மையும் அதிகாரமும்",
 "denomProfiles/reformed-baptists/coreDoctrines/1": "கிருபையின் கோட்பாடுகள் (கால்வினிய இரட்சிப்பியல்)",
 "denomProfiles/reformed-baptists/coreDoctrines/2": "பாப்டிஸ்ட் உடன்படிக்கை இறையியல்",
 "denomProfiles/reformed-baptists/coreDoctrines/3": "முழுக்கின் மூலம் விசுவாசியின் ஞானஸ்நானம்",
 "denomProfiles/reformed-baptists/coreDoctrines/4": "கர்த்தருடைய நாள் கிறிஸ்தவ ஓய்வுநாளாக",
 "denomProfiles/reformed-baptists/focuses/0": "விளக்கவுரைப் பிரசங்கம்",
 "denomProfiles/reformed-baptists/focuses/1": "விசுவாச அறிக்கை மற்றும் வினாவிடைப் போதனை",
 "denomProfiles/reformed-baptists/focuses/2": "பியூரிட்டன் மற்றும் குறிப்பிட்ட பாப்டிஸ்ட் எழுத்துகளை மீட்டெடுத்தல்",
 "denomProfiles/reformed-baptists/focuses/3": "சபை நாட்டுதலும் போதகர் பயிற்சியும்",
 "denomProfiles/reformed-baptists/practices/0": "கீச்சின் வினாவிடை (1693) மற்றும் 1689 விசுவாச அறிக்கையின் பயன்பாடு",
 "denomProfiles/reformed-baptists/practices/1": "பல மூப்பர்களின் தலைமை",
 "denomProfiles/reformed-baptists/practices/2": "சங்கீதங்களும் பாடல்களும், பெரும்பாலும் மேடை நிகழ்ச்சிப் பாணி இசையின்றி",
 "denomProfiles/reformed-baptists/practices/3": "சபை ஒழுங்கும் உறுப்பினர் உடன்படிக்கைகளும்",
 "denomProfiles/reformed-baptists/influenced/0/name": "தென் பாப்டிஸ்ட் மாநாடு",
 "denomProfiles/reformed-baptists/influenced/0/text": "தென் பாப்டிஸ்டுகளிடையே ஏற்பட்ட 'இளம், அமைதியற்ற, சீர்திருத்த' (Young, Restless, Reformed) கால்வினிய மறுமலர்ச்சி சீர்திருத்த பாப்டிஸ்ட் எழுத்துகளைச் சார்ந்திருந்தது.",
 "denomProfiles/reformed-baptists/influenced/1/name": "ஆப்பிரிக்கா மற்றும் ஆசியாவில் சீர்திருத்த பாப்டிஸ்ட் சபைகள்",
 "denomProfiles/reformed-baptists/influenced/1/text": "கென்யா, நைஜீரியா, பிலிப்பைன்ஸ் மற்றும் பிற இடங்களில் உள்ள சபைகள் 1689 விசுவாச அறிக்கையை ஏற்றுக்கொண்டுள்ளன.",
 "denomProfiles/reformed-baptists/keyFigures/0/name": "பெஞ்சமின் கீச்",
 "denomProfiles/reformed-baptists/keyFigures/0/role": "பதினேழாம் நூற்றாண்டின் குறிப்பிட்ட பாப்டிஸ்ட் போதகர்; அவரது வினாவிடை இன்றும் பயன்படுத்தப்படுகிறது.",
 "denomProfiles/reformed-baptists/keyFigures/1/name": "சார்லஸ் ஹாடன் ஸ்பர்ஜன்",
 "denomProfiles/reformed-baptists/keyFigures/1/role": "1855-இல் தம் சபைக்காக 1689 விசுவாச அறிக்கையை மறுபதிப்பு செய்தார்.",
 "denomProfiles/reformed-baptists/keyFigures/2/name": "எரோல் ஹல்ஸ்",
 "denomProfiles/reformed-baptists/keyFigures/2/role": "ஆங்கிலப் போதகர்; 'ரிஃபர்மேஷன் டுடே' (Reformation Today) இதழின் ஆசிரியர் (1970 முதல்).",
 "denomProfiles/reformed-baptists/keyFigures/3/name": "வால்டர் சான்ட்ரி",
 "denomProfiles/reformed-baptists/keyFigures/3/role": "அமெரிக்க சீர்திருத்த பாப்டிஸ்ட் போதகரும் எழுத்தாளரும்.",
 "denomProfiles/primitive-baptists/tagline": "பழைய பள்ளி பாப்டிஸ்டுகள்: முன்குறிப்புவாதிகள், மிஷன் எதிர்ப்பாளர்கள், இசைக்கருவியின்றிப் பாடுபவர்கள்.",
 "denomProfiles/primitive-baptists/coreDoctrines/0": "நிபந்தனையற்ற தெரிந்தெடுப்பும் குறிப்பிட்ட மீட்பும்",
 "denomProfiles/primitive-baptists/coreDoctrines/1": "மறுபிறப்பு மனித வழிமுறைகளால் அல்ல, தேவனுடைய நேரடிச் செயலால் நிகழ்வது",
 "denomProfiles/primitive-baptists/coreDoctrines/2": "முழுக்கின் மூலம் விசுவாசியின் ஞானஸ்நானம்",
 "denomProfiles/primitive-baptists/coreDoctrines/3": "கால் கழுவுதல் ஒரு நியமமாக",
 "denomProfiles/primitive-baptists/coreDoctrines/4": "உள்ளூர்ச் சபைக்கு அப்பால் மனித அமைப்புகள் எதுவும் இல்லை",
 "denomProfiles/primitive-baptists/focuses/0": "'ஆதி' புதிய ஏற்பாட்டு நடைமுறைக்கு உண்மையாயிருத்தல்",
 "denomProfiles/primitive-baptists/focuses/1": "தெரிந்தெடுக்கப்பட்டோரை ஆறுதல்படுத்தும் பிரசங்கம்",
 "denomProfiles/primitive-baptists/focuses/2": "எளிய வழிபாடு",
 "denomProfiles/primitive-baptists/focuses/3": "உள்ளூர்ச் சபையின் சுதந்திரம்",
 "denomProfiles/primitive-baptists/practices/0": "இசைக்கருவியின்றிப் பாடல் பாடுதல்",
 "denomProfiles/primitive-baptists/practices/1": "கால் கழுவுதலுடன் மாதாந்திர அல்லது ஒழுங்கான திருவிருந்து",
 "denomProfiles/primitive-baptists/practices/2": "சுயமாக வருவாய் ஈட்டும் மூப்பர்கள்",
 "denomProfiles/primitive-baptists/practices/3": "வருடாந்திர சங்கக் கூட்டங்கள்",
 "denomProfiles/primitive-baptists/influenced/0/name": "சேக்ரட் ஹார்ப் பாடல் மரபு",
 "denomProfiles/primitive-baptists/influenced/0/text": "சில ஆதி பாப்டிஸ்ட் சமூகங்கள் 'வடிவ-குறியீட்டு' (shape-note) பாடல் முறையைப் பாதுகாக்க உதவின.",
 "denomProfiles/primitive-baptists/influenced/1/name": "ஆதி பாப்டிஸ்ட் சர்வமீட்புவாதிகள்",
 "denomProfiles/primitive-baptists/influenced/1/text": "இந்த இயக்கத்திலிருந்து தோன்றிய ஒரு சிறிய அப்பலாச்சியக் குழு.",
 "denomProfiles/primitive-baptists/keyFigures/0/name": "ஜோஷுவா லாரன்ஸ்",
 "denomProfiles/primitive-baptists/keyFigures/0/role": "கெஹுக்கீ சங்கத்தில் மிஷன் எதிர்ப்புப் போராட்டத்தை வழிநடத்திய வட கரோலினா மூப்பர்.",
 "denomProfiles/primitive-baptists/keyFigures/1/name": "கில்பர்ட் பீபி",
 "denomProfiles/primitive-baptists/keyFigures/1/role": "பழைய பள்ளி பாப்டிஸ்டுகளின் முதன்மை இதழான 'சைன்ஸ் ஆஃப் தி டைம்ஸ்' (Signs of the Times) இதழின் ஆசிரியர் (1832 முதல்).",
 "denomProfiles/old-order-mennonites/tagline": "பத்தொன்பதாம் நூற்றாண்டுத் திருச்சபை ஒழுங்கைக் கடைப்பிடிக்கும், எளிய வாழ்வும் குதிரை வண்டிப் பயணமும் கொண்ட மென்னோனைட்டுகள்.",
 "denomProfiles/old-order-mennonites/coreDoctrines/0": "விசுவாசியின் ஞானஸ்நானம்",
 "denomProfiles/old-order-mennonites/coreDoctrines/1": "எதிர்ப்பின்மை (வன்முறையையும் இராணுவ சேவையையும் மறுத்தல்)",
 "denomProfiles/old-order-mennonites/coreDoctrines/2": "உலகத்திலிருந்து பிரிந்திருத்தல்",
 "denomProfiles/old-order-mennonites/coreDoctrines/3": "தாழ்மையும் சமூகத்திற்குக் கீழ்ப்படிதலும்",
 "denomProfiles/old-order-mennonites/coreDoctrines/4": "1632-ஆம் ஆண்டின் டோர்ட்ரெக்ட் விசுவாச அறிக்கை",
 "denomProfiles/old-order-mennonites/focuses/0": "நவீனப் புதுமைகளுக்கு எதிராக மரபைக் காத்தல்",
 "denomProfiles/old-order-mennonites/focuses/1": "குடும்ப மற்றும் விவசாய வாழ்வு",
 "denomProfiles/old-order-mennonites/focuses/2": "பரஸ்பர உதவி",
 "denomProfiles/old-order-mennonites/focuses/3": "எளிய உடையும் அடக்கமும்",
 "denomProfiles/old-order-mennonites/practices/0": "பென்சில்வேனியா ஜெர்மன் மொழி ஆராதனைகள்",
 "denomProfiles/old-order-mennonites/practices/1": "கால் கழுவுதலும் பரிசுத்த முத்தமும்",
 "denomProfiles/old-order-mennonites/practices/2": "சீட்டுப் போட்டு ஊழியர்களைத் தேர்ந்தெடுத்தல்",
 "denomProfiles/old-order-mennonites/practices/3": "எட்டாம் வகுப்பு வரையிலான சமூகப் பள்ளிகள்",
 "denomProfiles/old-order-mennonites/influenced/0/name": "ஆமிஷ்",
 "denomProfiles/old-order-mennonites/influenced/0/text": "பழைய ஒழுங்கு ஆமிஷ் மக்களும் பழைய ஒழுங்கு மென்னோனைட்டுகளும் நவீனத்துவத்திற்கு ஒத்த எதிர்ப்பைக் கொண்டுள்ளனர்.",
 "denomProfiles/old-order-mennonites/influenced/1/name": "பழமைவாத மென்னோனைட் குழுக்கள்",
 "denomProfiles/old-order-mennonites/influenced/1/text": "பிற்காலப் பழமைவாதப் பிளவுகள் பழைய ஒழுங்கு முன்மாதிரியைச் சார்ந்திருந்தன.",
 "denomProfiles/old-order-mennonites/keyFigures/0/name": "ஜேக்கப் விஸ்லர்",
 "denomProfiles/old-order-mennonites/keyFigures/0/role": "இந்தியானா ஆயர்; அவரது 1872 பிரிவினை பழைய ஒழுங்கு இயக்கத்தைத் தொடங்கியது.",
 "denomProfiles/old-order-mennonites/keyFigures/1/name": "ஆபிரகாம் மார்ட்டின்",
 "denomProfiles/old-order-mennonites/keyFigures/1/role": "ஒன்டாரியோ பழைய ஒழுங்குப் பிரிவினையின் தலைவர் (1889).",
 "denomProfiles/old-order-mennonites/keyFigures/2/name": "ஜோனஸ் மார்ட்டின்",
 "denomProfiles/old-order-mennonites/keyFigures/2/role": "1893 பிரிவினையை வழிநடத்திய லங்காஸ்டர் கவுண்டி ஆயர்.",
 "denomProfiles/mennonite-brethren/tagline": "1860-இல் ரஷ்யாவில் ஏற்பட்ட எழுப்புதலில் பிறந்த சுவிசேஷ மென்னோனைட்டுகள்.",
 "denomProfiles/mennonite-brethren/coreDoctrines/0": "தனிப்பட்ட மனமாற்றமும் மறுபிறப்பும்",
 "denomProfiles/mennonite-brethren/coreDoctrines/1": "முழுக்கின் மூலம் விசுவாசியின் ஞானஸ்நானம்",
 "denomProfiles/mennonite-brethren/coreDoctrines/2": "சீஷத்துவமும் இயேசுவைப் பின்பற்றுதலும்",
 "denomProfiles/mennonite-brethren/coreDoctrines/3": "சமாதானம் ஏற்படுத்துதலும் எதிர்ப்பின்மையும்",
 "denomProfiles/mennonite-brethren/coreDoctrines/4": "திருச்சபை விசுவாசிகளின் சமூகமாக",
 "denomProfiles/mennonite-brethren/focuses/0": "நற்செய்திப் பணியும் மிஷன்களும்",
 "denomProfiles/mennonite-brethren/focuses/1": "சபை நாட்டுதல்",
 "denomProfiles/mennonite-brethren/focuses/2": "வேதாகமப் போதனை",
 "denomProfiles/mennonite-brethren/focuses/3": "சமாதான மற்றும் நிவாரணப் பணி",
 "denomProfiles/mennonite-brethren/practices/0": "முழுக்கு ஞானஸ்நானம்",
 "denomProfiles/mennonite-brethren/practices/1": "நினைவுகூருதலாகத் திருவிருந்து",
 "denomProfiles/mennonite-brethren/practices/2": "சபைப் பாடலும் பாடகர் குழுக்களும்",
 "denomProfiles/mennonite-brethren/practices/3": "மிஷன்களிலும் பள்ளிகளிலும் மாநாட்டு ஒத்துழைப்பு",
 "denomProfiles/mennonite-brethren/influenced/0/name": "இந்தியாவில் மென்னோனைட் சகோதரர் சபைகள்",
 "denomProfiles/mennonite-brethren/influenced/0/text": "இந்த மிஷன்கள் உலகின் மிகப்பெரிய மென்னோனைட் சகோதரர் மாநாடுகளில் ஒன்றை உருவாக்கின.",
 "denomProfiles/mennonite-brethren/influenced/1/name": "காங்கோ மென்னோனைட் சகோதரர்கள்",
 "denomProfiles/mennonite-brethren/influenced/1/text": "காங்கோ ஜனநாயகக் குடியரசில் உள்ள சபை இக்குடும்பத்தின் மிகப்பெரியவற்றில் ஒன்றாக வளர்ந்தது.",
 "denomProfiles/mennonite-brethren/keyFigures/0/name": "எட்வர்ட் வுஸ்ட்",
 "denomProfiles/mennonite-brethren/keyFigures/0/role": "பக்திவாதப் பிரசங்கியார்; அவரது எழுப்புதல் நிறுவனர்களுக்கு ஊக்கமளித்தது.",
 "denomProfiles/mennonite-brethren/keyFigures/1/name": "யோஹான் கிளாசென்",
 "denomProfiles/mennonite-brethren/keyFigures/1/role": "குழுவுக்குச் சட்டபூர்வ அங்கீகாரம் பெற்றுத்தந்த ஆரம்பகாலத் தலைவர்.",
 "denomProfiles/mennonite-brethren/keyFigures/2/name": "ஆபிரகாம் மற்றும் மரியா ஃப்ரீசன்",
 "denomProfiles/mennonite-brethren/keyFigures/2/role": "1889 முதல் இந்தியாவில் தெலுங்கு மக்களிடையே பணியாற்றிய முன்னோடி மிஷனரிகள்.",
 "denomProfiles/mennonite-brethren/inIndia": "தெலுங்கு பேசுவோரிடையே மென்னோனைட் சகோதரர் பணி 1889-இல் தொடங்கியது; ஷம்சாபாத், மஹபூப்நகர், ஜட்செர்லா ஆகியவற்றை மையமாகக் கொண்ட தெலங்கானா மற்றும் ஆந்திரப் பிரதேசத்தின் மென்னோனைட் சகோதரர் சபைகள் உலகின் மிகப்பெரிய மென்னோனைட் சகோதரர் அமைப்புகளில் அடங்கும்.",
 "denomProfiles/wisconsin-lutheran-synod/tagline": "ஐக்கியம் பற்றிய உறுதியான கோட்பாட்டைக் கொண்ட, கண்டிப்பான விசுவாச அறிக்கைசார் அமெரிக்க லூத்தரன்கள்.",
 "denomProfiles/wisconsin-lutheran-synod/coreDoctrines/0": "வேதாகமத்தின் பிழையின்மையும் சொல்லுக்குச் சொல் ஆவியால் அருளப்பட்ட தன்மையும்",
 "denomProfiles/wisconsin-lutheran-synod/coreDoctrines/1": "விசுவாசத்தின் மூலம் கிருபையினால் நீதிமானாக்கப்படுதல்",
 "denomProfiles/wisconsin-lutheran-synod/coreDoctrines/2": "திருவிருந்தில் கிறிஸ்துவின் மெய்ப்பிரசன்னம்",
 "denomProfiles/wisconsin-lutheran-synod/coreDoctrines/3": "ஞானஸ்நான மறுபிறப்பு",
 "denomProfiles/wisconsin-lutheran-synod/coreDoctrines/4": "ஐக்கியத்தின் அடிப்படையாகக் கோட்பாட்டு ஒற்றுமை",
 "denomProfiles/wisconsin-lutheran-synod/focuses/0": "தூய கோட்பாடு",
 "denomProfiles/wisconsin-lutheran-synod/focuses/1": "திருச்சபைப் பள்ளிகளில் கிறிஸ்தவக் கல்வி",
 "denomProfiles/wisconsin-lutheran-synod/focuses/2": "விசுவாச அறிக்கைசார் மிஷன் கூட்டாண்மைகள்",
 "denomProfiles/wisconsin-lutheran-synod/focuses/3": "போதகர்களுக்கும் ஆசிரியர்களுக்கும் பயிற்சி",
 "denomProfiles/wisconsin-lutheran-synod/practices/0": "மூடிய திருவிருந்து (close communion)",
 "denomProfiles/wisconsin-lutheran-synod/practices/1": "வரலாற்று லூத்தரன் வழிபாட்டு முறை",
 "denomProfiles/wisconsin-lutheran-synod/practices/2": "உறுதிப்பூசுதலுக்கு முன் வினாவிடைப் போதனை",
 "denomProfiles/wisconsin-lutheran-synod/practices/3": "லூத்தரன் தொடக்க மற்றும் உயர்நிலைப் பள்ளிகள்",
 "denomProfiles/wisconsin-lutheran-synod/influenced/0/name": "சுவிசேஷ லூத்தரன் சங்கம்",
 "denomProfiles/wisconsin-lutheran-synod/influenced/0/text": "விசுவாச அறிக்கைசார் சுவிசேஷ லூத்தரன் மாநாட்டில் நெருங்கிய கூட்டாளி.",
 "denomProfiles/wisconsin-lutheran-synod/influenced/1/name": "விசுவாச அறிக்கைசார் சுவிசேஷ லூத்தரன் மாநாடு",
 "denomProfiles/wisconsin-lutheran-synod/influenced/1/text": "1993-இல் இந்தச் சர்வதேச அமைப்பை நிறுவ WELS உதவியது.",
 "denomProfiles/wisconsin-lutheran-synod/keyFigures/0/name": "ஜான் மூல்ஹாய்சர்",
 "denomProfiles/wisconsin-lutheran-synod/keyFigures/0/role": "முதல் தலைவரும் நிறுவனரும் (1850).",
 "denomProfiles/wisconsin-lutheran-synod/keyFigures/1/name": "அடால்ஃப் ஹோனெக்கே",
 "denomProfiles/wisconsin-lutheran-synod/keyFigures/1/role": "சங்கத்தைக் கண்டிப்பாக விசுவாச அறிக்கைசார்ந்ததாக்கிய இறையியலாளர்.",
 "denomProfiles/wisconsin-lutheran-synod/keyFigures/2/name": "ஜான் ஃபிலிப் கோலர்",
 "denomProfiles/wisconsin-lutheran-synod/keyFigures/2/role": "விளக்கவுரை சார்ந்த 'வாவடோசா இறையியலின்' தலைவர்.",
 "denomProfiles/orthodox-presbyterian-church/tagline": "மேச்சனின் திருச்சபை: 1936 பிளவில் பிறந்த கண்டிப்பான வெஸ்ட்மின்ஸ்டர் பிரஸ்பிடேரியனிசம்.",
 "denomProfiles/orthodox-presbyterian-church/coreDoctrines/0": "வேதாகமத்தின் பிழையின்மை",
 "denomProfiles/orthodox-presbyterian-church/coreDoctrines/1": "வெஸ்ட்மின்ஸ்டர் கால்வினிசம்",
 "denomProfiles/orthodox-presbyterian-church/coreDoctrines/2": "உடன்படிக்கை இறையியல்",
 "denomProfiles/orthodox-presbyterian-church/coreDoctrines/3": "கிறிஸ்துவின் பதிலீட்டுப் பாவநிவர்த்தி",
 "denomProfiles/orthodox-presbyterian-church/coreDoctrines/4": "உடன்படிக்கைக்குள் குழந்தை ஞானஸ்நானம்",
 "denomProfiles/orthodox-presbyterian-church/focuses/0": "கோட்பாட்டு உண்மைத்தன்மை",
 "denomProfiles/orthodox-presbyterian-church/focuses/1": "வெளிநாட்டு மற்றும் உள்நாட்டு மிஷன்கள்",
 "denomProfiles/orthodox-presbyterian-church/focuses/2": "போதகர் பயிற்சி",
 "denomProfiles/orthodox-presbyterian-church/focuses/3": "சீர்திருத்த விசுவாசத் தற்காப்பியல்",
 "denomProfiles/orthodox-presbyterian-church/practices/0": "சங்கீதங்களும் பாடல்களும் (டிரினிட்டி சங்கீதப் பாடல் நூல்)",
 "denomProfiles/orthodox-presbyterian-church/practices/1": "குழந்தைகளுக்கு வினாவிடைப் போதனை",
 "denomProfiles/orthodox-presbyterian-church/practices/2": "மூப்பர்கள் நடத்தும் சபை ஒழுங்கு",
 "denomProfiles/orthodox-presbyterian-church/practices/3": "ஒழுங்கான திருவிருந்து",
 "denomProfiles/orthodox-presbyterian-church/influenced/0/name": "அமெரிக்காவில் உள்ள பிரஸ்பிடேரியன் திருச்சபை",
 "denomProfiles/orthodox-presbyterian-church/influenced/0/text": "OPC-யின் இறையியலும் ஊழியர்களும் 1973-இல் நிறுவப்பட்ட PCA-வின் மீது செல்வாக்குச் செலுத்தினர்.",
 "denomProfiles/orthodox-presbyterian-church/influenced/1/name": "வேதாகம பிரஸ்பிடேரியன் திருச்சபை",
 "denomProfiles/orthodox-presbyterian-church/influenced/1/text": "கார்ல் மெக்கின்டயர் தலைமையில் 1937-இல் ஏற்பட்ட பிளவு.",
 "denomProfiles/orthodox-presbyterian-church/influenced/2/name": "சீர்திருத்த விசுவாசத் தற்காப்பியல்",
 "denomProfiles/orthodox-presbyterian-church/influenced/2/text": "வான் டில்லின் முன்னனுமானவாதம் சுவிசேஷ இயக்கம் முழுவதும் பரவியது.",
 "denomProfiles/orthodox-presbyterian-church/keyFigures/0/name": "ஜே. கிரெஷம் மேச்சன்",
 "denomProfiles/orthodox-presbyterian-church/keyFigures/0/role": "நிறுவனரும் தாராளவாத இறையியலின் முன்னணி விமர்சகரும்.",
 "denomProfiles/orthodox-presbyterian-church/keyFigures/1/name": "கொர்னேலியஸ் வான் டில்",
 "denomProfiles/orthodox-presbyterian-church/keyFigures/1/role": "வெஸ்ட்மின்ஸ்டர் இறையியல் கல்லூரியின் விசுவாசத் தற்காப்பாளர்.",
 "denomProfiles/orthodox-presbyterian-church/keyFigures/2/name": "ஜான் மர்ரே",
 "denomProfiles/orthodox-presbyterian-church/keyFigures/2/role": "ஸ்காட்லாந்தில் பிறந்த முறைசார் இறையியலாளர்.",
 "denomProfiles/free-church-of-scotland/tagline": "திருச்சபையின் ஆவிக்குரிய சுதந்திரத்தைக் காத்த, 1843 பிளவின் ஸ்காட்லாந்துப் பிரஸ்பிடேரியன்கள்.",
 "denomProfiles/free-church-of-scotland/coreDoctrines/0": "கிறிஸ்து ஒருவரே திருச்சபையின் தலைவர்",
 "denomProfiles/free-church-of-scotland/coreDoctrines/1": "வெஸ்ட்மின்ஸ்டர் கால்வினிசம்",
 "denomProfiles/free-church-of-scotland/coreDoctrines/2": "வேதாகமத்தின் பிழையின்மை",
 "denomProfiles/free-church-of-scotland/coreDoctrines/3": "உடன்படிக்கை இறையியல்",
 "denomProfiles/free-church-of-scotland/coreDoctrines/4": "கர்த்தருடைய நாளின் பரிசுத்தம்",
 "denomProfiles/free-church-of-scotland/focuses/0": "நற்செய்திப் பிரசங்கம்",
 "denomProfiles/free-church-of-scotland/focuses/1": "ஸ்காட்லாந்து நகரங்களில் சபை நாட்டுதல்",
 "denomProfiles/free-church-of-scotland/focuses/2": "இறையியல் கல்வி (எடின்பரோ இறையியல் கல்லூரி)",
 "denomProfiles/free-church-of-scotland/focuses/3": "வெளிநாட்டு மிஷன் கூட்டாண்மைகள்",
 "denomProfiles/free-church-of-scotland/practices/0": "சங்கீதம் பாடுதல், பெரும்பாலும் இசைக்கருவியின்றி",
 "denomProfiles/free-church-of-scotland/practices/1": "ஆயத்த ஆராதனைகளுடன் கூடிய திருவிருந்துப் பருவங்கள்",
 "denomProfiles/free-church-of-scotland/practices/2": "மூப்பர்களின் வீடு சந்திப்பு",
 "denomProfiles/free-church-of-scotland/practices/3": "சில சபைகளில் கேலிக் மொழி ஆராதனைகள்",
 "denomProfiles/free-church-of-scotland/influenced/0/name": "தென்னிந்தியத் திருச்சபை",
 "denomProfiles/free-church-of-scotland/influenced/0/text": "சென்னையில் இருந்த சுதந்திரத் திருச்சபை மிஷன்கள் இந்த ஒன்றிணைந்த திருச்சபையில் இணைந்தன.",
 "denomProfiles/free-church-of-scotland/influenced/1/name": "வட இந்தியத் திருச்சபை",
 "denomProfiles/free-church-of-scotland/influenced/1/text": "பம்பாய், நாக்பூர், கல்கத்தாவில் இருந்த அதன் மிஷன்கள் இந்த ஒன்றிணைந்த திருச்சபையில் இணைந்தன.",
 "denomProfiles/free-church-of-scotland/influenced/2/name": "ஸ்காட்லாந்து சுதந்திரத் திருச்சபை (தொடர்ச்சி)",
 "denomProfiles/free-church-of-scotland/influenced/2/text": "2000-இல் பிரிந்து சென்ற ஒரு சிறுபான்மைக் குழு.",
 "denomProfiles/free-church-of-scotland/keyFigures/0/name": "தாமஸ் சால்மர்ஸ்",
 "denomProfiles/free-church-of-scotland/keyFigures/0/role": "பிளவின் தலைவரும் முதல் மாடரேட்டரும்.",
 "denomProfiles/free-church-of-scotland/keyFigures/1/name": "ராபர்ட் கேண்ட்லிஷ்",
 "denomProfiles/free-church-of-scotland/keyFigures/1/role": "சால்மர்ஸுக்குப் பின் சுதந்திரத் திருச்சபையின் முன்னணி ஊழியர்.",
 "denomProfiles/free-church-of-scotland/keyFigures/2/name": "அலெக்சாண்டர் டஃப்",
 "denomProfiles/free-church-of-scotland/keyFigures/2/role": "1843-இல் சுதந்திரத் திருச்சபையில் இணைந்த, கல்கத்தாவின் மிஷனரிக் கல்வியாளர்.",
 "denomProfiles/free-church-of-scotland/keyFigures/3/name": "தாமஸ் கத்ரி",
 "denomProfiles/free-church-of-scotland/keyFigures/3/role": "பிரசங்கியாரும் ஏழைக் குழந்தைகளுக்கான 'கந்தல் பள்ளிகளின்' (ragged schools) முன்னோடியும்.",
 "denomProfiles/free-church-of-scotland/inIndia": "பிளவின்போது இந்தியாவில் இருந்த ஸ்காட்லாந்துத் திருச்சபையின் மிஷனரிகளில் ஏறக்குறைய அனைவரும் சுதந்திரத் திருச்சபையில் இணைந்தனர்; கல்கத்தாவின் அலெக்சாண்டர் டஃப், சென்னையின் ஜான் ஆண்டர்சன் (அவரது பள்ளி பின்னர் சென்னைக் கிறிஸ்தவக் கல்லூரியானது), பம்பாயின் ஜான் வில்சன் ஆகியோர் இவர்களில் அடங்குவர்; இந்த மிஷன்கள் பின்னர் தென்னிந்தியத் திருச்சபையிலும் வட இந்தியத் திருச்சபையிலும் இணைந்தன."
}
