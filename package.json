{
  "name": "ecclesia-atlas",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "validate": "tsx scripts/validate-content.ts",
    "build": "npm run validate && tsc --noEmit -p . && vite build",
    "preview": "vite preview",
    "coverage": "tsx scripts/coverage.ts",
    "qa": "tsx scripts/content-qa.ts",
    "typecheck": "tsc --noEmit -p .",
    "ask": "tsx scripts/ask.ts",
    "build:single": "npm run validate && vite build --mode single --outDir dist-single",
    "build:artifact": "npm run build:single && node scripts/artifact-page.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.133.0",
    "@dagrejs/dagre": "^3.1.1",
    "@fontsource/cormorant-garamond": "^5.3.0",
    "@fontsource/nunito-sans": "^5.3.0",
    "@xyflow/react": "^12.12.0",
    "d3": "^7.9.0",
    "d3-sankey": "^0.12.3",
    "framer-motion": "^14.2.0",
    "fuse.js": "^7.5.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4",
    "topojson-client": "^3.1.0",
    "world-atlas": "^2.0.2",
    "zod": "^4.6.7",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/d3": "^7.4.3",
    "@types/d3-sankey": "^0.12.5",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/topojson-client": "^3.1.5",
    "@vitejs/plugin-react": "^6.1.2",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vite-plugin-singlefile": "^2.3.3"
  }
}
